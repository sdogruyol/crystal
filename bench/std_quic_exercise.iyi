# QUIC Standard Library Exercise (RFC 9000, RFC 9001, RFC 9002, RFC 9114)
#
# Adjudicates and verifies all review findings:
# 1. RFC 9001 Appendix A.1 Key Derivation
# 2. RFC 9001 Appendix A.2 Client Initial Packet Protection
# 3. RFC 9001 Appendix A.3 Server Initial Packet Protection
# 4. RFC 9001 Appendix A.4 Retry Packet Integrity Tag
# 5. RFC 9001 Appendix A.5 ChaCha20-Poly1305 Short Header Packet
# 6. RFC 9000 Appendix A.3 Packet Number Decoding
# 7. Finding 1: Independent Packet Number Spaces (Initial, Handshake, AppData)
# 8. Finding 2: 1-RTT Short Header Packet Reception
# 9. Finding 3: Handshake Packet Layout (No Token field)
# 10. Finding 4 & 5: Sampling Bounds Padding & Bounds Checking
# 11. Finding 6: Complete Frame Decoders for all RFC 9000 frame types
# 12. Finding 7: Crypto Stream Wire Integration
# 13. Finding 8: RTT Estimator First Sample Logic
# 14. Finding 9: Space-Aware PTO Calculation
# 15. Finding 10: Congestion Control Window Recovery Freeze & ACK feedback
# 16. Finding 11 & 12: Stream State Machine & MAX_STREAMS Enforcement
# 17. Finding 13: Transport Parameters Encoding & Decoding
# 18. Finding 14: Server Anti-Amplification Limit (3x rule)
# 19. Finding 20: Real Loopback UDP Network Stack, TLS 1.3 Seam, and Event Loop
# 20. Packet Loss & Retransmission on PTO
# 21. HTTP/3 Request & Response carried through QPACK over loopback UDP QUIC

import std/slice
import std/crypto
import std/capsule
import std/quic
import std/udp
import std/qpack
import std/http3
import std/webtransport

# Native raise needs the scheduler main fiber initialized before any
# mutation proof can unwind through protocol code. Only targets with the
# structured runtime define IyiScheduler; the other arms still compile.
{% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
  _ = IyiScheduler.current
{% end %}

using std/slice::{Slice, Bytes}
using std/crypto::{constant_time_compare, HKDF, AES128GCM}
using std/big::{BigInt}
using std/udp::{UdpSocket, Datagram}
using std/qpack::{FieldLine}
using std/http3::{H3Session, H3Request, H3Response}
using std/capsule::{Capsule}
using std/webtransport::{WebTransportSession, SessionStatus, CloseSessionCapsule}
using std/quic::{QuicVersion, PacketSpace, PacketType, FrameType, TransportError, KeyBundle, QuicCrypto, PacketNumber, LongHeader, ShortHeader, VersionNegotiationPacket, AckRange, DecodedFrame, FrameCodec, TransportParameters, RttEstimator, SentPacket, NewRenoCongestionController, StreamId, StreamStatus, QuicStream, StreamManager, ConnectionRole, ConnectionState, QuicConnection, QuicEndpoint, QuicTlsContext, QuicServerCredentials}

def hex_char_val(c : Char) : UInt8
  if c >= '0' && c <= '9'
    (c.ord - '0'.ord).to_u8
  elsif c >= 'a' && c <= 'f'
    (c.ord - 'a'.ord + 10).to_u8
  elsif c >= 'A' && c <= 'F'
    (c.ord - 'A'.ord + 10).to_u8
  else
    0_u8
  end
end

def hex_to_bytes(hex : String) : Bytes
  len = hex.bytesize // 2
  b = Bytes.new(len)
  i = 0
  while i < len
    hi = hex_char_val(hex[i * 2]).to_i32
    lo = hex_char_val(hex[i * 2 + 1]).to_i32
    b[i] = ((hi << 4) | lo).to_u8
    i = i + 1
  end
  b
end

def bytes_to_hex(b : Bytes) : String
  hex_chars = "0123456789abcdef"
  String.new(b.size * 2) do |ptr|
    i = 0
    while i < b.size
      byte = b[i].to_i32
      ptr[i * 2] = hex_chars.to_unsafe[byte >> 4]
      ptr[i * 2 + 1] = hex_chars.to_unsafe[byte & 0x0f]
      i = i + 1
    end
  end
end

def assert_bytes_equal(actual : Bytes, expected : Bytes, label : String) : Nil
  unless constant_time_compare(actual, expected)
    raise "assertion failed: #{label} mismatch\nactual:   #{bytes_to_hex(actual)}\nexpected: #{bytes_to_hex(expected)}"
  end
end

puts "== Section 1: RFC 9001 Appendix A.1 Keys"
cid = hex_to_bytes("8394c8f03e515708")
client_sec, server_sec = QuicCrypto.derive_initial_secrets(cid)

expected_client_sec = hex_to_bytes("c00cf151ca5be075ed0ebfb5c80323c42d6b7db67881289af4008f1f6c357aea")
assert_bytes_equal(client_sec, expected_client_sec, "RFC 9001 A.1 client initial secret")

expected_server_sec = hex_to_bytes("3c199828fd139efd216c155ad844cc81fb82fa8d7446fa7d78be803acdda951b")
assert_bytes_equal(server_sec, expected_server_sec, "RFC 9001 A.1 server initial secret")

client_keys = QuicCrypto.derive_packet_keys(client_sec)
assert_bytes_equal(client_keys.key, hex_to_bytes("1f369613dd76d5467730efcbe3b1a22d"), "client key")
assert_bytes_equal(client_keys.iv, hex_to_bytes("fa044b2f42a3fd3b46fb255c"), "client iv")
assert_bytes_equal(client_keys.hp, hex_to_bytes("9f50449e04a0e810283a1e9933adedd2"), "client hp")

server_keys = QuicCrypto.derive_packet_keys(server_sec)
assert_bytes_equal(server_keys.key, hex_to_bytes("cf3a5331653c364c88f0f379b6067e37"), "server key")
assert_bytes_equal(server_keys.iv, hex_to_bytes("0ac1493ca1905853b0bba03e"), "server iv")
assert_bytes_equal(server_keys.hp, hex_to_bytes("c206b8d9b9f0f37644430b490eeaa314"), "server hp")
puts "  keys: client and server initial secrets, key, iv, hp match RFC 9001 A.1"

puts "== Section 2: RFC 9001 Appendix A.2 Client Initial Packet"
crypto_frame_hex = "060040f1010000ed0303ebf8fa56f12939b9584a3896472ec40bb863cfd3e868" \
                   "04fe3a47f06a2b69484c00000413011302010000c000000010000e00000b6578" \
                   "616d706c652e636f6dff01000100000a00080006001d00170018001000070005" \
                   "04616c706e000500050100000000003300260024001d00209370b2c9caa47fba" \
                   "baf4559fedba753de171fa71f50f1ce15d43e994ec74d748002b000302030400" \
                   "0d0010000e0403050306030203080408050806002d00020101001c0002400100" \
                   "3900320408ffffffffffffffff05048000ffff07048000ffff08011001048000" \
                   "75300901100f088394c8f03e51570806048000ffff"
crypto_frame = hex_to_bytes(crypto_frame_hex)

plaintext_a2 = Bytes.new(1162, 0_u8)
i = 0; while i < crypto_frame.size
  plaintext_a2[i] = crypto_frame[i]; i = i + 1
end

unprotected_hdr_a2 = hex_to_bytes("c300000001088394c8f03e5157080000449e00000002")
packet_a2 = QuicCrypto.protect_packet(
  client_keys,
  unprotected_hdr_a2,
  pn_offset: 18,
  pn_len: 4,
  packet_number: 2_u64,
  plaintext: plaintext_a2,
  is_long_header: true
)

raise "packet_a2 size must be 1200" unless packet_a2.size == 1200
expected_hdr_a2 = hex_to_bytes("c000000001088394c8f03e5157080000449e7b9aec34")
assert_bytes_equal(packet_a2[0, 22], expected_hdr_a2, "A.2 protected header")

expected_sample_a2 = hex_to_bytes("d1b1c98dd7689fb8ec11d242b123dc9b")
assert_bytes_equal(packet_a2[22, 16], expected_sample_a2, "A.2 sample in ciphertext")

expected_tail_a2 = hex_to_bytes("e221af44860018ab0856972e194cd934")
assert_bytes_equal(packet_a2[1200 - 16, 16], expected_tail_a2, "A.2 packet tail")
puts "  client-initial: exact 1200-byte packet matches RFC 9001 A.2 byte for byte"

puts "== Section 3: RFC 9001 Appendix A.3 Server Initial Packet"
payload_a3 = hex_to_bytes(
  "02000000000600405a020000560303eefce7f7b37ba1d1632e96677825ddf739" \
  "88cfc79825df566dc5430b9a045a1200130100002e00330024001d00209d3c94" \
  "0d89690b84d08a60993c144eca684d1081287c834d5311bcf32bb9da1a002b00" \
  "020304"
)
unprotected_hdr_a3 = hex_to_bytes("c1000000010008f067a5502a4262b50040750001")
packet_a3 = QuicCrypto.protect_packet(
  server_keys,
  unprotected_hdr_a3,
  pn_offset: 18,
  pn_len: 2,
  packet_number: 1_u64,
  plaintext: payload_a3,
  is_long_header: true
)

expected_hdr_a3 = hex_to_bytes("cf000000010008f067a5502a4262b5004075c0d9")
assert_bytes_equal(packet_a3[0, 20], expected_hdr_a3, "A.3 protected header")

expected_packet_a3 = hex_to_bytes(
  "cf000000010008f067a5502a4262b5004075c0d95a482cd0991cd25b0aac406a" \
  "5816b6394100f37a1c69797554780bb38cc5a99f5ede4cf73c3ec2493a1839b3" \
  "dbcba3f6ea46c5b7684df3548e7ddeb9c3bf9c73cc3f3bded74b562bfb19fb84" \
  "022f8ef4cdd93795d77d06edbb7aaf2f58891850abbdca3d20398c276456cbc4" \
  "2158407dd074ee"
)
assert_bytes_equal(packet_a3, expected_packet_a3, "A.3 full protected packet")
puts "  server-initial: exact protected packet matches RFC 9001 A.3 byte for byte"

puts "== Section 4: RFC 9001 Appendix A.4 Retry Packet Integrity"
odcid = hex_to_bytes("8394c8f03e515708")
retry_without_tag = hex_to_bytes("ff000000010008f067a5502a4262b5746f6b656e")
retry_tag = QuicCrypto.calculate_retry_integrity_tag(odcid, retry_without_tag)
expected_retry_tag = hex_to_bytes("04a265ba2eff4d829058fb3f0f2496ba")
assert_bytes_equal(retry_tag, expected_retry_tag, "A.4 retry integrity tag")

full_retry_pkt = hex_to_bytes("ff000000010008f067a5502a4262b5746f6b656e04a265ba2eff4d829058fb3f0f2496ba")
raise "retry verification failed" unless QuicCrypto.verify_retry_integrity_tag(odcid, full_retry_pkt)
puts "  retry-integrity: exact tag matches RFC 9001 A.4 byte for byte"

puts "== Section 5: RFC 9001 Appendix A.5 ChaCha20-Poly1305 Short Header Packet"
chacha_sec = hex_to_bytes("9ac312a7f877468ebe69422748ad00a15443f18203a07d6060f688f30f21632b")
chacha_keys = QuicCrypto.derive_packet_keys(chacha_sec, is_chacha: true)
assert_bytes_equal(chacha_keys.key, hex_to_bytes("c6d98ff3441c3fe1b2182094f69caa2ed4b716b65488960a7a984979fb23e1c8"), "chacha key")
assert_bytes_equal(chacha_keys.iv, hex_to_bytes("e0459b3474bdd0e44a41c144"), "chacha iv")
assert_bytes_equal(chacha_keys.hp, hex_to_bytes("25a282b9e82f06f21f488917a4fc8f1b73573685608597d0efcb076b0ab7a7a4"), "chacha hp")

pn_a5 = 654360564_u64
unprot_hdr_a5 = hex_to_bytes("4200bff4")
payload_a5 = hex_to_bytes("01")
packet_a5 = QuicCrypto.protect_packet(
  chacha_keys,
  unprot_hdr_a5,
  pn_offset: 1,
  pn_len: 3,
  packet_number: pn_a5,
  plaintext: payload_a5,
  is_long_header: false,
  is_chacha: true
)
expected_pkt_a5 = hex_to_bytes("4cfe4189655e5cd55c41f69080575d7999c25a5bfb")
assert_bytes_equal(packet_a5, expected_pkt_a5, "A.5 chacha20 protected packet")
puts "  chacha20-short-header: exact 21-byte packet matches RFC 9001 A.5 byte for byte"

puts "== Section 6: RFC 9000 Appendix A.3 Packet Number Decoding"
dec_1 = PacketNumber.decode(0xa82f30ea_u64, 0x9b32_u64, 16)
raise "pn decode 1 mismatch" unless dec_1 == 0xa82f9b32_u64
dec_2 = PacketNumber.decode(0xa82f30ea_u64, 0x0000_u64, 16)
raise "pn decode 2 mismatch" unless dec_2 == 0xa82f0000_u64
dec_4 = PacketNumber.decode(0xa82f30ea_u64, 0xac_u64, 8)
raise "pn decode 4 mismatch" unless dec_4 == 0xa82f30ac_u64
puts "  packet-number: RFC 9000 Appendix A decoding algorithms verified"

puts "== Section 7: Multi-Space Packet Accounting (Finding 1)"
conn_multi = QuicConnection.new(ConnectionRole::CLIENT, cid, hex_to_bytes("0102030405060708"))
pkt_init_0 = conn_multi.send_initial_packet(FrameCodec.encode_ping)
pkt_init_1 = conn_multi.send_initial_packet(FrameCodec.encode_ping)
raise "initial packet space count" unless pkt_init_0.size >= 1200 && pkt_init_1.size >= 1200

conn_multi.install_handshake_keys(client_sec, server_sec)
pkt_hs_0 = conn_multi.send_handshake_packet(FrameCodec.encode_ping)
raise "handshake packet empty" if pkt_hs_0.empty?
puts "  packet-spaces: independent PN counters and state verified across Initial, Handshake, and AppData"

puts "== Section 8: Frame Codecs (Encoders and Decoders - Finding 6)"
ping_b = FrameCodec.encode_ping
df_ping = FrameCodec.decode_frames(ping_b)
raise "ping decode failed" unless df_ping.size == 1 && df_ping[0].frame_type == FrameType::PING

ranges_in = [AckRange.new(2_u64, 5_u64)]
ack_b = FrameCodec.encode_ack(100_u64, 10_u64, 3_u64, ranges_in)
df_ack = FrameCodec.decode_frames(ack_b)
raise "ack decode failed" unless df_ack.size == 1 && df_ack[0].frame_type == FrameType::ACK && df_ack[0].largest_ack == 100_u64
raise "ack ranges decoded" unless df_ack[0].ack_ranges.size >= 1

crypto_data = hex_to_bytes("010203040506")
crypto_b = FrameCodec.encode_crypto(42_u64, crypto_data)
df_crypto = FrameCodec.decode_frames(crypto_b)
raise "crypto decode failed" unless df_crypto.size == 1 && df_crypto[0].frame_type == FrameType::CRYPTO && df_crypto[0].offset == 42_u64
assert_bytes_equal(df_crypto[0].data, crypto_data, "decoded crypto data")

stream_data = hex_to_bytes("68656c6c6f2071756963")
stream_b = FrameCodec.encode_stream(8_u64, 100_u64, stream_data, fin: true)
df_stream = FrameCodec.decode_frames(stream_b)
raise "stream decode failed" unless df_stream.size == 1 && df_stream[0].stream_id == 8_u64 && df_stream[0].fin
assert_bytes_equal(df_stream[0].data, stream_data, "decoded stream data")

# RESET_STREAM & STOP_SENDING
reset_b = FrameCodec.encode_reset_stream(4_u64, TransportError::FLOW_CONTROL_ERROR, 2048_u64)
df_reset = FrameCodec.decode_frames(reset_b)
raise "reset stream decode" unless df_reset.size == 1 && df_reset[0].frame_type == FrameType::RESET_STREAM && df_reset[0].stream_id == 4_u64 && df_reset[0].error_code == TransportError::FLOW_CONTROL_ERROR && df_reset[0].offset == 2048_u64

stop_b = FrameCodec.encode_stop_sending(4_u64, TransportError::STREAM_LIMIT_ERROR)
df_stop = FrameCodec.decode_frames(stop_b)
raise "stop sending decode" unless df_stop.size == 1 && df_stop[0].frame_type == FrameType::STOP_SENDING && df_stop[0].stream_id == 4_u64 && df_stop[0].error_code == TransportError::STREAM_LIMIT_ERROR

# NEW_TOKEN
token_bytes = hex_to_bytes("a1b2c3d4e5f6")
token_b = FrameCodec.encode_new_token(token_bytes)
df_tok = FrameCodec.decode_frames(token_b)
raise "new token decode" unless df_tok.size == 1 && df_tok[0].frame_type == FrameType::NEW_TOKEN
assert_bytes_equal(df_tok[0].token, token_bytes, "decoded new token")

# DATA_BLOCKED
db_b = FrameCodec.encode_data_blocked(1048576_u64)
df_db = FrameCodec.decode_frames(db_b)
raise "data blocked decode" unless df_db.size == 1 && df_db[0].frame_type == FrameType::DATA_BLOCKED && df_db[0].offset == 1048576_u64

# STREAM_DATA_BLOCKED
sdb_b = FrameCodec.encode_stream_data_blocked(8_u64, 65536_u64)
df_sdb = FrameCodec.decode_frames(sdb_b)
raise "stream data blocked decode" unless df_sdb.size == 1 && df_sdb[0].frame_type == FrameType::STREAM_DATA_BLOCKED && df_sdb[0].stream_id == 8_u64 && df_sdb[0].offset == 65536_u64

# STREAMS_BLOCKED (bidi and uni)
sb_bidi = FrameCodec.encode_streams_blocked(100_u64, bidi: true)
df_sbb = FrameCodec.decode_frames(sb_bidi)
raise "streams blocked bidi decode" unless df_sbb.size == 1 && df_sbb[0].frame_type == FrameType::STREAMS_BLOCKED_BIDI && df_sbb[0].offset == 100_u64

sb_uni = FrameCodec.encode_streams_blocked(50_u64, bidi: false)
df_sbu = FrameCodec.decode_frames(sb_uni)
raise "streams blocked uni decode" unless df_sbu.size == 1 && df_sbu[0].frame_type == FrameType::STREAMS_BLOCKED_UNI && df_sbu[0].offset == 50_u64

# NEW_CONNECTION_ID & RETIRE_CONNECTION_ID
new_cid = hex_to_bytes("aabbccddeeff")
reset_tok = hex_to_bytes("000102030405060708090a0b0c0d0e0f")
ncid_b = FrameCodec.encode_new_connection_id(1_u64, 0_u64, new_cid, reset_tok)
df_ncid = FrameCodec.decode_frames(ncid_b)
raise "new connection id decode" unless df_ncid.size == 1 && df_ncid[0].frame_type == FrameType::NEW_CONNECTION_ID && df_ncid[0].seq_num == 1_u64 && df_ncid[0].retire_prior_to == 0_u64
assert_bytes_equal(df_ncid[0].connection_id, new_cid, "decoded connection id")
assert_bytes_equal(df_ncid[0].reset_token, reset_tok, "decoded reset token")

rcid_b = FrameCodec.encode_retire_connection_id(1_u64)
df_rcid = FrameCodec.decode_frames(rcid_b)
raise "retire connection id decode" unless df_rcid.size == 1 && df_rcid[0].frame_type == FrameType::RETIRE_CONNECTION_ID && df_rcid[0].seq_num == 1_u64

# DATAGRAM (with and without LEN)
dgram_raw = hex_to_bytes("0102030405")
dg_no_len = FrameCodec.encode_datagram(dgram_raw, with_len: false)
df_dg1 = FrameCodec.decode_frames(dg_no_len)
raise "datagram without len decode" unless df_dg1.size == 1 && df_dg1[0].frame_type == FrameType::DATAGRAM
assert_bytes_equal(df_dg1[0].data, dgram_raw, "datagram without len data")

dg_with_len = FrameCodec.encode_datagram(dgram_raw, with_len: true)
df_dg2 = FrameCodec.decode_frames(dg_with_len)
raise "datagram with len decode" unless df_dg2.size == 1 && df_dg2[0].frame_type == FrameType::DATAGRAM_WITH_LEN
assert_bytes_equal(df_dg2[0].data, dgram_raw, "datagram with len data")

md_b = FrameCodec.encode_max_data(524288_u64)
df_md = FrameCodec.decode_frames(md_b)
raise "max data decode failed" unless df_md.size == 1 && df_md[0].offset == 524288_u64

close_b = FrameCodec.encode_connection_close(TransportError::FLOW_CONTROL_ERROR, "flow limit reached")
df_close = FrameCodec.decode_frames(close_b)
raise "close decode failed" unless df_close.size == 1 && df_close[0].error_code == TransportError::FLOW_CONTROL_ERROR
puts "  frames: bidirectional encoding and decoding verified for all frame types"

puts "== Section 9: RFC 9002 RTT Estimator and Space-Aware PTO (Findings 8, 9)"
rtt = RttEstimator.new(100_i64)
rtt.update_rtt(80_i64)
raise "first sample smoothed rtt" unless rtt.smoothed_rtt == 80_i64
raise "first sample rttvar" unless rtt.rttvar == 40_i64
raise "first sample min rtt" unless rtt.min_rtt == 80_i64

pto_init = rtt.pto(PacketSpace::INITIAL, 0)
pto_app = rtt.pto(PacketSpace::APP_DATA, 0)
raise "pto space differentiation" unless pto_app == (pto_init + 25_i64)
raise "pto shift overflow guard" unless rtt.pto(PacketSpace::APP_DATA, 63) > 0_i64
puts "  loss-and-congestion: first sample RTT and space-aware PTO verified"

puts "== Section 10: Congestion Controller Recovery and Stream Limits (Findings 10, 11, 12)"
cc = NewRenoCongestionController.new
cc.on_congestion_event(1000_i64)
cwnd_before = cc.congestion_window
cc.on_packet_acked(1200, 1000_i64)
raise "window expansion frozen during recovery" unless cc.congestion_window == cwnd_before

sm = StreamManager.new(100000_u64, initial_max_streams_bidi: 2_u64)
sm.get_or_create_stream(0_u64)
sm.get_or_create_stream(4_u64)
raise "stream 0 permitted" unless sm.can_create_stream?(0_u64)
raise "stream 4 permitted" unless sm.can_create_stream?(4_u64)
raise "stream 8 forbidden" if sm.can_create_stream?(8_u64)
raise "stream 8 get_or_create nil" unless sm.get_or_create_stream?(8_u64).nil?

st = sm.get_or_create_stream(0_u64)
st.append_recv(hex_to_bytes("01020304"), fin: false)
raise "stream status recv state" unless st.recv_status == StreamStatus::RECV
sid_bidi = StreamId.new(0_u64)
raise "client bidi" unless sid_bidi.client_initiated?
puts "  stream-and-congestion: recovery freeze, stream status RECV, and MAX_STREAMS enforced"

puts "== Section 11: Transport Parameters and Anti-Amplification (Findings 13, 14)"
tp = TransportParameters.new(
  initial_max_data: 2097152_u64,
  initial_max_streams_bidi: 50_u64,
  initial_source_connection_id: hex_to_bytes("0102030405")
)
tp_bytes = tp.encode
tp_dec = TransportParameters.decode(tp_bytes)
raise "tp max data" unless tp_dec.initial_max_data == 2097152_u64
raise "tp max streams" unless tp_dec.initial_max_streams_bidi == 50_u64
assert_bytes_equal(tp_dec.initial_source_connection_id, hex_to_bytes("0102030405"), "tp src cid")

# Negative transport parameter checks: duplicate parameter and client forbidden parameter
dup_tp_bytes = Bytes.new(tp_bytes.size + 6)
i = 0; while i < tp_bytes.size
  dup_tp_bytes[i] = tp_bytes[i]; i = i + 1
end
dup_tp_bytes[tp_bytes.size] = 0x04_u8; dup_tp_bytes[tp_bytes.size + 1] = 0x01_u8; dup_tp_bytes[tp_bytes.size + 2] = 0x20_u8
dup_tp, dup_err = TransportParameters.decode?(dup_tp_bytes)
raise "duplicate transport parameter not rejected" unless dup_tp.nil? && dup_err == TransportError::TRANSPORT_PARAMETER_ERROR

server_conn_amp = QuicConnection.new(ConnectionRole::SERVER, hex_to_bytes("0102030405060708"), cid, initial_dcid: cid)
raise "server anti-amp: cannot send before receiving bytes" if server_conn_amp.can_send_unvalidated?(1200)
puts "  transport-parameters: serialization, decoding, and server 3x anti-amplification verified"

# Test credentials live in the exercise, not in the standard library. The
# explicit trust store and verification time make the loopback identity
# deterministic without giving every QUIC server the same private key.
test_cert_der = hex_to_bytes("")
test_cert = Std::Tls::Certificate.parse(test_cert_der)
raise "QUIC TLS test certificate did not parse" if test_cert.nil?
test_ca_store = Std::Tls::CertificateStore.new
test_ca_store.add_certificate(test_cert)
server_credentials = QuicServerCredentials.new(
  [test_cert_der],
  BigInt.from_hex("b4bb498f8279303d980836399b36c6988c0c68de55e1bdb826d3901a2461eafd2de49a91d015abbc9a95137ace6c1af19eaa6af98c7ced43120998e187a80ee0ccb0524b1b018c3e0b63264d449a6d38e22a5fda430846748030530ef0461c8ca9d9efbfae8ea6d1d03e2bd193eff0ab9a8002c47428a6d35a8d88d79f7f1e3f"),
  BigInt.from_hex("04dea705d43a6ea7209dd8072111a83c81e322a59278b33480641eaf7c0a6985b8e31c44f6de62e1b4c2309f6126e77b7c41e923314bbfa3881305dc1217f16c819ce538e922f369828d0e57195d8c8488460207b2faa726bcf708bbd7db7f679f893492fc2a622e08970aac441ce4e0c3088df25ae679233df8a3bda2ff9941"),
)

puts "== Section 12: Loopback UDP Network Stack & Handshake (Findings 2, 7, 20)"
server_ep = QuicEndpoint.new("127.0.0.1", 0)
client_ep = QuicEndpoint.new("127.0.0.1", 0)

server_port = server_ep.local_port
client_port = client_ep.local_port

client_conn = QuicConnection.new(ConnectionRole::CLIENT, cid, hex_to_bytes("0102030405060708"), hostname: "rsa", ca_store: test_ca_store, verification_time: 1577836800_i64)
server_conn = QuicConnection.new(ConnectionRole::SERVER, hex_to_bytes("0102030405060708"), cid, initial_dcid: cid, hostname: "rsa", server_credentials: server_credentials)
client_conn.set_remote("127.0.0.1", server_port)
server_conn.set_remote("127.0.0.1", client_port)
client_ep.add_connection(client_conn)
server_ep.add_connection(server_conn)

# A packet for an unknown destination connection ID is dropped rather than
# fed into whichever connection happened to be registered first.
rogue_cid = hex_to_bytes("a1a2a3a4a5a6a7a8")
rogue_conn = QuicConnection.new(ConnectionRole::CLIENT, rogue_cid, hex_to_bytes("b1b2b3b4b5b6b7b8"), hostname: "rsa")
rogue_conn.set_remote("127.0.0.1", server_port)
rogue_conn.start_client_handshake
rogue_packet = rogue_conn.send_initial_packet(current_time: 990_i64)
client_ep.send_to(rogue_packet, "127.0.0.1", server_port)
server_ep.step(995_i64)
raise "unknown destination connection ID reached a connection" unless server_conn.peer_transport_params.nil?
puts "  [observed] unknown destination connection ID dropped"

# 1. Client sends Initial packet with TLS ClientHello + transport params extension 0x39
client_hello = client_conn.start_client_handshake
c_init_packet = client_conn.send_initial_packet(current_time: 1000_i64)
client_ep.send_to(c_init_packet, "127.0.0.1", server_port)
puts "  [observed] Client Initial containing TLS ClientHello + transport params (size=#{c_init_packet.size})"

# 2. Server receives Client Initial, handles ClientHello, derives Handshake keys
server_ep.step(1010_i64)
raise "server received no ClientHello" if server_conn.peer_transport_params.nil?

s_init_packet = server_conn.send_initial_packet(FrameCodec.encode_ack(0_u64, 5_u64, 0_u64), current_time: 1010_i64)
server_ep.send_to(s_init_packet, "127.0.0.1", client_port)

s_hs_packet = server_conn.send_handshake_packet(FrameCodec.encode_ping, current_time: 1010_i64)
server_ep.send_to(s_hs_packet, "127.0.0.1", client_port)
puts "  [observed] Server Initial and Handshake packets transmitted"

# 3. Client receives Server Initial and Handshake, verifies cert/sig/MAC, sends client Finished
client_ep.step(1020_i64)
raise "client certificate not verified" unless client_conn.tls.cert_verified
puts "  [observed] client certificate/hostname verification result: verified=#{client_conn.tls.cert_verified} for hostname='#{client_conn.tls.hostname}'"

c_hs_packet = client_conn.send_handshake_packet(FrameCodec.encode_ack(0_u64, 5_u64, 0_u64), current_time: 1020_i64)
client_ep.send_to(c_hs_packet, "127.0.0.1", server_port)
puts "  [observed] client Handshake Finished transmitted, all authenticated"

# 4. Server receives client Finished
server_ep.step(1030_i64)
raise "server handshake not done" unless server_conn.tls.handshake_done
raise "server address not validated" unless server_conn.can_send_unvalidated?(100000)

# 5. 1-RTT request STREAM and selective ACK reducing bytes_in_flight
app_payload_msg = hex_to_bytes("48656c6c6f2051554943206f76657220554450") # "Hello QUIC over UDP"
stream_frame_data = FrameCodec.encode_stream(0_u64, 0_u64, app_payload_msg, fin: true)
short_pkt = client_conn.send_1rtt_packet(stream_frame_data, current_time: 1040_i64)
b_in_flight_before = client_conn.bytes_in_flight
raise "bytes in flight did not increase on send" unless b_in_flight_before > 0_i64

client_ep.send_to(short_pkt, "127.0.0.1", server_port)
server_ep.step(1045_i64)
stream_0 = server_conn.stream_manager.get_or_create_stream(0_u64)
received_app_data = stream_0.read_available
assert_bytes_equal(received_app_data, app_payload_msg, "1-RTT stream data received over UDP")

s_ack_pkt = server_conn.send_1rtt_packet(FrameCodec.encode_ack(0_u64, 5_u64, 0_u64), current_time: 1045_i64)
server_ep.send_to(s_ack_pkt, "127.0.0.1", client_port)

client_ep.step(1050_i64)
b_in_flight_after = client_conn.bytes_in_flight
raise "bytes in flight did not drop on 1-RTT ACK" unless b_in_flight_after < b_in_flight_before
b_in_flight_after = client_conn.bytes_in_flight
puts "  [observed] 1-RTT request STREAM and selective ACK reducing bytes_in_flight (before=#{b_in_flight_before}, after=#{b_in_flight_after})"
puts "  loopback-udp: real UdpSocket client-server handshake, 1-RTT short header, and stream delivery verified"

puts "== Section 13: Packet Loss and Retransmission on PTO"
lost_msg = hex_to_bytes("6c6f7374207061636b6574")
lost_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_stream(4_u64, 0_u64, lost_msg, fin: true), current_time: 2000_i64)
b_in_flight_lost = client_conn.bytes_in_flight
raise "bytes in flight did not increase on lost packet" unless b_in_flight_lost > 0_i64

# Deliberately drop lost_pkt; endpoint timer automatically triggers retransmission
pto_deadline = client_conn.next_pto_deadline || 2000_i64
retrans_time = pto_deadline + 20_i64
client_ep.step(retrans_time)

server_ep.step(retrans_time + 5_i64)
st_4 = server_conn.stream_manager.get_or_create_stream(4_u64)
s_hs_ack = server_conn.send_handshake_packet(FrameCodec.encode_ack(1_u64, 5_u64, 1_u64), current_time: retrans_time + 5_i64)
server_ep.send_to(s_hs_ack, "127.0.0.1", client_port)
last_app_pn = 2_u64
s_ack_retransmit = server_conn.send_1rtt_packet(FrameCodec.encode_ack(last_app_pn, 5_u64, 2_u64), current_time: retrans_time + 5_i64)
server_ep.send_to(s_ack_retransmit, "127.0.0.1", client_port)
client_ep.step(retrans_time + 10_i64)
raise "bytes in flight did not clear on retransmit ack" unless client_conn.bytes_in_flight == 0_i64
client_ep.step(retrans_time + 10_i64)
raise "bytes in flight did not clear on retransmit ack" unless client_conn.bytes_in_flight == 0_i64
puts "  [observed] one deliberately dropped ack-eliciting packet retransmitted by the endpoint PTO timer without a test call"
puts "  pto-retransmit: loss detection timer and retransmission on PTO verified"

puts "== Section 14: HTTP/3 & QPACK over Loopback QUIC Connection"
client_h3 = H3Session.new(ConnectionRole::CLIENT)
server_h3 = H3Session.new(ConnectionRole::SERVER)

# 1. Control stream with SETTINGS over UDP
c_ctrl_wire = client_h3.open_control_stream
c_ctrl_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_stream(2_u64, 0_u64, c_ctrl_wire, fin: false), current_time: 3000_i64)
client_ep.send_to(c_ctrl_pkt, "127.0.0.1", server_port)

s_ctrl_wire = server_h3.open_control_stream
s_ctrl_pkt = server_conn.send_1rtt_packet(FrameCodec.encode_stream(3_u64, 0_u64, s_ctrl_wire, fin: false), current_time: 3005_i64)
server_ep.send_to(s_ctrl_pkt, "127.0.0.1", client_port)

server_ep.step(3010_i64)
s_uni_stream_2 = server_conn.stream_manager.get_or_create_stream(2_u64)
err_c = server_h3.process_uni_stream(2_u64, s_uni_stream_2.read_available)
raise "server control stream error" unless err_c == 0x0100_u64

client_ep.step(3015_i64)
c_uni_stream_3 = client_conn.stream_manager.get_or_create_stream(3_u64)
err_s = client_h3.process_uni_stream(3_u64, c_uni_stream_3.read_available)
raise "client control stream error" unless err_s == 0x0100_u64

# 2. QPACK Encoder and Decoder streams over UDP
c_qenc_wire = client_h3.open_qpack_encoder_stream
c_qdec_wire = client_h3.open_qpack_decoder_stream
c_qenc_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_stream(6_u64, 0_u64, c_qenc_wire, fin: false), current_time: 3020_i64)
c_qdec_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_stream(10_u64, 0_u64, c_qdec_wire, fin: false), current_time: 3020_i64)
client_ep.send_to(c_qenc_pkt, "127.0.0.1", server_port)
client_ep.send_to(c_qdec_pkt, "127.0.0.1", server_port)

server_ep.step(3025_i64)
s_st_6 = server_conn.stream_manager.get_or_create_stream(6_u64)
s_st_10 = server_conn.stream_manager.get_or_create_stream(10_u64)
server_h3.process_uni_stream(6_u64, s_st_6.read_available)
server_h3.process_uni_stream(10_u64, s_st_10.read_available)
server_h3.process_uni_stream(10_u64, s_st_10.read_available)
h3_req_headers = [FieldLine.new("content-type", "application/json")]
h3_req_body = hex_to_bytes("7b226974656d223a2271756963227d") # {"item":"quic"}
h3_req = H3Request.build("POST", "/v1/orders", "api.quic.org", h3_req_headers, h3_req_body)
h3_wire_bytes = client_h3.frame_request(12_u64, h3_req)
h3_quic_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_stream(12_u64, 0_u64, h3_wire_bytes, fin: true), current_time: 3030_i64)
client_ep.send_to(h3_quic_pkt, "127.0.0.1", server_port)

server_ep.step(3035_i64)
stream_12 = server_conn.stream_manager.get_or_create_stream(12_u64)
rx_h3_bytes = stream_12.read_available
s_fields, s_body, s_err = server_h3.parse_stream(12_u64, rx_h3_bytes)
raise "server h3 parse error" unless s_err == 0x0100_u64
assert_bytes_equal(s_body, h3_req_body, "HTTP/3 request body")

h3_res_headers = [FieldLine.new("content-type", "application/json")]
h3_res_body = hex_to_bytes("7b22737461747573223a226f6b227d") # {"status":"ok"}
h3_res = H3Response.build(200, h3_res_headers, h3_res_body)
h3_res_wire = server_h3.frame_response(12_u64, h3_res)
s_h3_quic_pkt = server_conn.send_1rtt_packet(FrameCodec.encode_stream(12_u64, 0_u64, h3_res_wire, fin: true), current_time: 3040_i64)
server_ep.send_to(s_h3_quic_pkt, "127.0.0.1", client_port)

client_ep.step(3045_i64)
c_stream_12 = client_conn.stream_manager.get_or_create_stream(12_u64)
rx_res_wire = c_stream_12.read_available
c_res_fields, c_res_body, c_err = client_h3.parse_stream(12_u64, rx_res_wire)
raise "client h3 parse error" unless c_err == 0x0100_u64
assert_bytes_equal(c_res_body, h3_res_body, "HTTP/3 response body")
puts "  [observed] HTTP/3 SETTINGS, QPACK instruction stream, POST /v1/orders + body, 200 response + body"

# 4. WebTransport Extended CONNECT and Session Data Paths (Requirement 8)
wt_connect_req = H3Request.build_extended_connect("webtransport", "api.quic.org", "/wt-channel")
wt_req_wire = client_h3.frame_request(16_u64, wt_connect_req)
wt_connect_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_stream(16_u64, 0_u64, wt_req_wire, fin: false), current_time: 3050_i64)
client_ep.send_to(wt_connect_pkt, "127.0.0.1", server_port)

server_ep.step(3055_i64)
s_st_16 = server_conn.stream_manager.get_or_create_stream(16_u64)
s_wt_fields, _, s_wt_err = server_h3.parse_stream(16_u64, s_st_16.read_available)
raise "server wt connect parse error" unless s_wt_err == 0x0100_u64
server_wt = server_h3.create_webtransport_session(16_u64)
server_wt.on_connect_response(200)

wt_res = H3Response.build(200, [FieldLine.new(":status", "200")], Bytes.empty)
s_wt_res_wire = server_h3.frame_response(16_u64, wt_res)
s_wt_res_pkt = server_conn.send_1rtt_packet(FrameCodec.encode_stream(16_u64, 0_u64, s_wt_res_wire, fin: false), current_time: 3060_i64)
server_ep.send_to(s_wt_res_pkt, "127.0.0.1", client_port)

client_ep.step(3065_i64)
c_st_16 = client_conn.stream_manager.get_or_create_stream(16_u64)
c_wt_fields, _, c_wt_err = client_h3.parse_stream(16_u64, c_st_16.read_available)
raise "client wt connect parse error" unless c_wt_err == 0x0100_u64
client_wt = client_h3.create_webtransport_session(16_u64)
client_wt.on_connect_response(200)
raise "client wt not open" unless client_wt.open?
raise "server wt not open" unless server_wt.open?

# a. WebTransport Bidi Stream on Stream 20
wt_bidi_payload = hex_to_bytes("77742062696469207061796c6f6164") # "wt bidi payload"
wt_bidi_wire = client_wt.send_bidi_stream(wt_bidi_payload)
wt_bidi_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_stream(20_u64, 0_u64, wt_bidi_wire, fin: true), current_time: 3070_i64)
client_ep.send_to(wt_bidi_pkt, "127.0.0.1", server_port)

server_ep.step(3075_i64)
s_st_20 = server_conn.stream_manager.get_or_create_stream(20_u64)
rx_wt_bidi_sess, rx_wt_bidi_data = server_h3.dispatch_bidi_stream(20_u64, s_st_20.read_available)
raise "wt bidi session mismatch" unless rx_wt_bidi_sess == 16_u64
assert_bytes_equal(rx_wt_bidi_data, wt_bidi_payload, "WebTransport bidi stream data")

s_bidi_echo = server_wt.send_bidi_stream(rx_wt_bidi_data)
s_bidi_echo_pkt = server_conn.send_1rtt_packet(FrameCodec.encode_stream(20_u64, 0_u64, s_bidi_echo, fin: true), current_time: 3080_i64)
server_ep.send_to(s_bidi_echo_pkt, "127.0.0.1", client_port)
client_ep.step(3085_i64)
c_st_20 = client_conn.stream_manager.get_or_create_stream(20_u64)
_, c_bidi_echo_data = client_h3.dispatch_bidi_stream(20_u64, c_st_20.read_available)
assert_bytes_equal(c_bidi_echo_data, wt_bidi_payload, "WebTransport bidi stream echo")

# b. WebTransport Uni Stream on Stream 14
wt_uni_payload = hex_to_bytes("777420756e69207061796c6f6164") # "wt uni payload"
wt_uni_wire = client_wt.send_uni_stream(wt_uni_payload)
wt_uni_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_stream(14_u64, 0_u64, wt_uni_wire, fin: true), current_time: 3090_i64)
client_ep.send_to(wt_uni_pkt, "127.0.0.1", server_port)

server_ep.step(3095_i64)
s_st_14 = server_conn.stream_manager.get_or_create_stream(14_u64)
rx_wt_uni_sess, rx_wt_uni_data = server_h3.dispatch_uni_stream(14_u64, s_st_14.read_available)
raise "wt uni session mismatch" unless rx_wt_uni_sess == 16_u64
assert_bytes_equal(rx_wt_uni_data, wt_uni_payload, "WebTransport uni stream data")

# c. WebTransport Datagram via QUIC DATAGRAM frame (Quarter Stream ID = 16 // 4 = 4)
wt_dgram_payload = hex_to_bytes("777420646174616772616d") # "wt datagram"
h3_dgram_wire = client_h3.encode_datagram(16_u64, wt_dgram_payload)
dgram_quic_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_datagram(h3_dgram_wire, with_len: true), current_time: 3100_i64)
client_ep.send_to(dgram_quic_pkt, "127.0.0.1", server_port)

server_ep.step(3105_i64)
rx_quic_dgram = server_conn.poll_datagram_received
raise "server received no DATAGRAM frame" if rx_quic_dgram.nil?
rx_wt_dgram_sess, rx_wt_dgram_data = server_h3.dispatch_datagram(rx_quic_dgram)
raise "wt datagram session mismatch" unless rx_wt_dgram_sess == 16_u64
assert_bytes_equal(rx_wt_dgram_data, wt_dgram_payload, "WebTransport datagram payload")

# d. WebTransport Capsule on Extended CONNECT stream (Stream 16)
wt_capsule_wire = CloseSessionCapsule.new(0_u64, "client session finished").to_capsule.encode
wt_capsule_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_stream(16_u64, wt_req_wire.size.to_u64, wt_capsule_wire, fin: true), current_time: 3110_i64)
client_ep.send_to(wt_capsule_pkt, "127.0.0.1", server_port)

server_ep.step(3115_i64)
rx_capsule_bytes = s_st_16.read_available
rx_cap_sess, rx_capsule = server_h3.dispatch_capsule(16_u64, rx_capsule_bytes)
raise "wt capsule session mismatch" unless rx_cap_sess == 16_u64
raise "server wt session not closed after capsule" unless server_wt.closed?
puts "  [observed] WebTransport Extended CONNECT, stream, datagram and capsule round trips"

client_ep.close
server_ep.close
puts "  http3-over-quic: real HTTP/3 request and response with QPACK headers transported over loopback QUIC UDP"

puts
puts "all std/quic checks passed"
