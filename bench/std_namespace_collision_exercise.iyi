# Every standard library module whose own name shadows a prelude type, loaded
# into one program at once.
#
# `module std/bool` makes a `Std::Bool` compilation unit. `std/iterator` writes
# `module std/iterator`, so it shares the `Std` namespace with that unit without
# importing it. If the enclosing namespace wins, an unqualified `Bool` inside
# `std/iterator` stops meaning the prelude's `Bool` and starts meaning a sibling
# module - and which sibling names exist depends on what else the program
# imported. That is the coupling R-1 refuses, and this file is what notices it:
# twenty shadowing modules in one program, each one used.
#
# The second shape is the same rule from the other side. A blanket
# `impl Enumerable for Array(T) forall T` that writes its own `each` pins
# `std/enumerable` to every element type the program instantiates, including
# types it cannot name, so importing `std/http` broke `std/enumerable`.

import std/bool
import std/box
using std/box::{Box}
import std/char
import std/comparable
import std/deque
using std/deque::{Deque}
import std/empty
import std/enum
import std/enumerable
using std/enumerable::{Enumerable}
import std/exception
import std/float
import std/indexable
import std/int
import std/iterator
import std/number
import std/regex
using std/regex::{Regex}
import std/set
using std/set::{Set}
import std/slice
import std/symbol
import std/time
using std/time::{Time}
import std/tuple

# The module that made the second shape visible, in the same program.
import std/http

def assert(cond : Bool, what : String) : Nil
  unless cond
    print "ASSERTION FAILED: "
    print what
    print "\n"
    raise what
  end
end

# The blanket `impl Enumerable for Array(T)` in std/enumerable is what the
# second shape broke, so the Enumerable defaults reached through an ordinary
# `Array` are the thing worth calling here.

puts "== unqualified prelude names still mean the prelude's types"

# Each of these is a name a sibling module also claims as its namespace. The
# annotation is the point: if the sibling won, none of this would compile.
flag : Bool = true
letter : Char = 'n'
count : Int32 = 41
ratio : Float64 = 0.5
text : String = "iyi"
items : Array(Int32) = [3, 1, 2]
pairs : Hash(String, Int32) = {"one" => 1}
window : Range(Int32, Int32) = 1..3
pair : Tuple(Int32, String) = {7, "seven"}

assert(flag, "Bool annotation is the prelude's Bool")
assert(letter.upcase == 'N', "Char annotation is the prelude's Char")
assert(count + 1 == 42, "Int32 annotation is the prelude's Int32")
assert(ratio * 2.0 == 1.0, "Float64 annotation is the prelude's Float64")
assert(text.size == 3, "String annotation is the prelude's String")
assert(items.size == 3, "Array annotation is the prelude's Array")
assert(pairs["one"] == 1, "Hash annotation is the prelude's Hash")
assert(window.includes?(2), "Range annotation is the prelude's Range")
assert(pair[0] == 7, "Tuple annotation is the prelude's Tuple")
puts "  nine prelude annotations verified under twenty shadowing modules"

puts "== the types those modules export are still reachable"

boxed = Box(Int32).box(11)
assert(Box(Int32).unbox(boxed) == 11, "std/box reachable")
deque = Deque(Int32).new
deque.push(5)
assert(deque.size == 1, "std/deque reachable")
set = Set(Int32).new
set.add(2)
assert(set.includes?(2), "std/set reachable")
assert(Regex.new("a+").match?("aaa"), "std/regex reachable")
assert(Time.utc(2026, 1, 1).year == 2026, "std/time reachable")
puts "  five shadowing modules answer through their own namespace"

puts "== the blanket Array impl does not pin std/enumerable to std/http"

# `std/http` is imported above. Before the fix this file did not get this far:
# `std/enumerable` refused to compile because its own `Array(T)` impl had to
# type-check `each` against element types only `std/http` can name.
headers = Std::Http::Headers.new
headers.add("Accept", "text/plain")
assert(headers.size == 1, "std/http headers usable alongside std/enumerable")

assert(items.count { |n| n > 1 } == 2, "Array reaches an Enumerable default")
assert(items.any? { |n| n == 3 }, "Array reaches Enumerable any?")
assert(items.sorted == [1, 2, 3], "the prelude's Array still enumerates")
puts "  std/http and std/enumerable coexist"

puts "all std namespace collision checks passed"
