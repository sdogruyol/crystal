# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def hex_to_bytes(hex : String) : Bytes
  len = hex.bytesize // 2
  Bytes.new(len) do |i|
    c1 = hex.to_unsafe[i * 2].to_i32
    c2 = hex.to_unsafe[i * 2 + 1].to_i32
    v1 = c1 >= 97 ? c1 - 87 : (c1 >= 65 ? c1 - 55 : c1 - 48)
    v2 = c2 >= 97 ? c2 - 87 : (c2 >= 65 ? c2 - 55 : c2 - 48)
    ((v1 << 4) | v2).to_u8
  end
end

def bytes_to_hex(bytes : Bytes) : String
  hex_chars = "0123456789abcdef"
  String.new(bytes.size * 2) do |buf|
    i = 0
    while i < bytes.size
      b = bytes[i].to_i32
      buf[i * 2] = hex_chars.to_unsafe[(b >> 4) & 15]
      buf[i * 2 + 1] = hex_chars.to_unsafe[b & 15]
      i = i + 1
    end
  end
end

def assert_true(cond : Bool, label : String) : Nil
  if cond
    puts "    pass: #{label}"
  else
    puts "    FAIL: #{label} - expected true, got false"
    raise "assertion failed: #{label}"
  end
end

def assert_eq(actual : String, expected : String, label : String) : Nil
  if actual == expected
    puts "    pass: #{label}"
  else
    puts "    FAIL: #{label} - expected #{expected}, got #{actual}"
    raise "assertion failed: #{label}"
  end
end

def assert_eq_i64(actual : Int64, expected : Int64, label : String) : Nil
  if actual == expected
    puts "    pass: #{label}"
  else
    puts "    FAIL: #{label} - expected #{expected}, got #{actual}"
    raise "assertion failed: #{label}"
  end
end

def assert_eq_i32(actual : Int32, expected : Int32, label : String) : Nil
  if actual == expected
    puts "    pass: #{label}"
  else
    puts "    FAIL: #{label} - expected #{expected}, got #{actual}"
    raise "assertion failed: #{label}"
  end
end

def assert_bytes_equal(actual : Bytes, expected : Bytes, label : String) : Nil
  if actual.size != expected.size
    puts "    FAIL: #{label} size mismatch: got #{actual.size}, expected #{expected.size}"
    raise "assertion failed: #{label} size mismatch"
  end
  i = 0
  while i < actual.size
    if actual[i] != expected[i]
      puts "    FAIL: #{label} mismatch at #{i}: got #{actual[i]}, expected #{expected[i]}"
      raise "assertion failed: #{label} byte mismatch at #{i}"
    end
    i = i + 1
  end
  puts "    pass: #{label}"
end

# =============================================================================
# Section 1: HPACK (RFC 7541)
# =============================================================================
def test_hpack : Nil
  puts "== Section 1: HPACK (RFC 7541)"

  # C.1 Integer representation
  buf_int = [] of UInt8
  Integer.encode(10_u64, 5, 0_u8, buf_int)
  assert_eq(bytes_to_hex(Slice(UInt8).new(buf_int.to_unsafe, buf_int.size)), "0a", "c.1.1 encode 10 with 5-bit prefix")
  dec1 = Integer.decode(hex_to_bytes("0a"), 0, 5)
  assert_true(!dec1.is_a?(HpackError) && dec1[0] == 10_u64, "c.1.1 decode 10")

  buf_int2 = [] of UInt8
  Integer.encode(1337_u64, 5, 0_u8, buf_int2)
  assert_eq(bytes_to_hex(Slice(UInt8).new(buf_int2.to_unsafe, buf_int2.size)), "1f9a0a", "c.1.2 encode 1337 with 5-bit prefix")
  dec2 = Integer.decode(hex_to_bytes("1f9a0a"), 0, 5)
  assert_true(!dec2.is_a?(HpackError) && dec2[0] == 1337_u64, "c.1.2 decode 1337")

  # Canonical Huffman
  buf_huff = [] of UInt8
  Huffman.encode("www.example.com", buf_huff)
  assert_eq(bytes_to_hex(Slice(UInt8).new(buf_huff.to_unsafe, buf_huff.size)), "f1e3c2e5f23a6ba0ab90f4ff", "c.4.1 huffman encode www.example.com")
  dec_huff = Huffman.decode(hex_to_bytes("f1e3c2e5f23a6ba0ab90f4ff"))
  assert_true(!dec_huff.is_a?(HpackError) && dec_huff == "www.example.com", "c.4.1 huffman decode www.example.com")
  # EOS symbol rejection
  eos_bytes = hex_to_bytes("ffffffff")
  dec_eos = Huffman.decode(eos_bytes)
  assert_true(dec_eos.is_a?(HpackError), "huffman rejects EOS symbol")

  # Static Table entries
  st1 = StaticTable.get(1)
  assert_true(!st1.nil? && st1.name == ":authority", "static table entry 1 is :authority")
  st_idx, st_exact = StaticTable.find(":method", "GET")
  assert_true(st_idx == 2 && st_exact, "static table find :method GET is 2")

  # Dynamic Table management & eviction
  dt = DynamicTable.new(256, 4096)
  f1 = HeaderField.new("custom-key", "custom-value")
  dt.add(f1)
  assert_eq_i32(dt.length, 1, "dynamic table length after insert")
  assert_eq_i32(dt.size, f1.size, "dynamic table size matches field size")

  # Decoder and Encoder round-trip
  enc = Encoder.new(4096, 4096, use_huffman: true)
  dec = Decoder.new(4096, 4096)
  hdrs = [
    HeaderField.new(":method", "GET"),
    HeaderField.new(":scheme", "http"),
    HeaderField.new(":path", "/"),
    HeaderField.new(":authority", "www.example.com"),
  ]
  encoded = enc.encode(hdrs)
  assert_true(encoded.size > 0, "hpack encoded bytes non-empty")
  decoded_res = dec.decode(encoded)
  case decoded_res
  in Array(HeaderField)
    assert_eq_i32(decoded_res.size, 4, "hpack decoded headers count")
    assert_eq(decoded_res[0].name, ":method", "first header name :method")
    assert_eq(decoded_res[0].value, "GET", "first header value GET")
  in HpackError
    raise "hpack decode failed: #{decoded_res.message}"
  end
end

# =============================================================================
# Section 2: QPACK (RFC 9204)
# =============================================================================
def test_qpack : Nil
  puts "== Section 2: QPACK (RFC 9204)"

  # Static table check
  st0 = Qpack.get_static(0)
  assert_true(!st0.nil? && st0.name == ":authority", "qpack static index 0 is :authority")
  st1 = Qpack.get_static(1)
  assert_true(!st1.nil? && st1.name == ":path" && st1.value == "/", "qpack static index 1 is :path /")

  # Dynamic table operations
  qdt = QpackDynamicTable.new(4096)
  qdt.insert("content-type", "application/json")
  assert_eq_i64(qdt.insert_count, 1_i64, "qpack dynamic table insert count")

  # Encoder & Decoder
  qenc = QpackEncoder.new(4096, 16)
  qdec = QpackDecoder.new(4096, 16)
  qfields = [
    FieldLine.new(":method", "POST"),
    FieldLine.new(":path", "/v1/resource"),
    FieldLine.new("content-type", "application/json"),
  ]
  enc_stream = [] of UInt8
  field_section = [] of UInt8
  err = qenc.encode(1_u64, qfields, enc_stream, field_section, allow_indexing: true, use_huffman: false)
  assert_true(err.nil?, "qpack encode succeeded without error")

  dec_stream = [] of UInt8
  if enc_stream.size > 0
    qdec.process_encoder_stream(Slice(UInt8).new(enc_stream.to_unsafe, enc_stream.size))
  end
  decoded_fields = qdec.decode_field_section(1_u64, Slice(UInt8).new(field_section.to_unsafe, field_section.size), dec_stream)
  case decoded_fields
  in Array(FieldLine)
    assert_eq_i32(decoded_fields.size, 3, "qpack decoded fields count matches")
    assert_eq(decoded_fields[0].name, ":method", "qpack field 0 name :method")
    assert_eq(decoded_fields[0].value, "POST", "qpack field 0 value POST")
  in QpackError
    raise "qpack decode failed: #{decoded_fields.message}"
  in Nil
    raise "qpack stream unexpectedly blocked"
  end
end

# =============================================================================
# Section 3: HTTP/2 (RFC 9113)
# =============================================================================
def test_http2 : Nil
  puts "== Section 3: HTTP/2 (RFC 9113)"

  # Preface verification
  assert_eq_i32(CLIENT_PREFACE_BYTES.size, 24, "client preface bytes size 24")
  assert_eq(CLIENT_PREFACE, "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n", "client preface string")

  # ErrorCode verification
  assert_eq_i64(ErrorCode::NO_ERROR.value, 0x00_i64, "NO_ERROR code 0x00")
  assert_eq_i64(ErrorCode::PROTOCOL_ERROR.value, 0x01_i64, "PROTOCOL_ERROR code 0x01")
  assert_eq_i64(ErrorCode::FLOW_CONTROL_ERROR.value, 0x03_i64, "FLOW_CONTROL_ERROR code 0x03")

  # FrameHeader parse & serialize
  fh = FrameHeader.new(12, FrameType::DATA, FrameFlag::END_STREAM, 3)
  fh_bytes = fh.serialize
  assert_eq_i32(fh_bytes.size, 9, "frame header length 9 bytes")
  parsed_fh = FrameHeader.parse(fh_bytes)
  case parsed_fh
  in FrameHeader
    assert_eq_i32(parsed_fh.length, 12, "parsed frame length")
    assert_true(parsed_fh.type == FrameType::DATA, "parsed frame type DATA")
    assert_true((parsed_fh.flags & FrameFlag::END_STREAM) != 0, "parsed frame flag END_STREAM")
    assert_eq_i32(parsed_fh.stream_id, 3, "parsed stream id 3")
  in Http2Error
    raise "frame header parse failed: #{parsed_fh.message}"
  end

  # Settings dictionary
  s = Settings.new
  s.set(SettingId::HEADER_TABLE_SIZE, 8192)
  assert_eq_i32(s.header_table_size, 8192, "settings header_table_size updated")

  # In-memory Client & Server handshake & request
  client = H2Client.new
  server = H2Server.new
  # Handshake exchange
  loop = true
  while loop
    loop = false
    c_out = client.flush_outbound
    if c_out.size > 0
      server.receive(c_out)
      loop = true
    end
    s_out = server.flush_outbound
    if s_out.size > 0
      client.receive(s_out)
      loop = true
    end
  end
  assert_true(true, "client and server HTTP/2 handshake exchanged")

  # Send request
  req = Request.new("GET", "/index.html", Headers.new, "")
  stream_id, req_err = client.send_request(req)
  assert_true(req_err.nil?, "client sent request")
  c_req_bytes = client.flush_outbound
  server.receive(c_req_bytes)
  rec_req = server.get_request(stream_id)
  assert_true(!rec_req.nil?, "server received request object")
  if r = rec_req
    assert_eq(r.method, "GET", "server request method GET")
    assert_eq(r.target, "/index.html", "server request target /index.html")
  end
end

# =============================================================================
# Section 4: HTTP/3 (RFC 9114)
# =============================================================================
def test_http3 : Nil
  puts "== Section 4: HTTP/3 (RFC 9114)"

  # Stream & Frame constants
  assert_true(H3StreamType::CONTROL == 0x00_u64, "H3 control stream type 0x00")
  assert_true(H3FrameType::DATA == 0x00_u64, "H3 DATA frame type 0x00")
  assert_true(H3FrameType::HEADERS == 0x01_u64, "H3 HEADERS frame type 0x01")
  assert_true(H3FrameType::SETTINGS == 0x04_u64, "H3 SETTINGS frame type 0x04")

  # Settings dictionary
  dict = SettingsDictionary.new
  dict.set(H3Setting::QPACK_MAX_TABLE_CAPACITY, 4096_u64)
  dict.set(H3Setting::ENABLE_CONNECT_PROTOCOL, 1_u64)
  encoded_settings = dict.serialize
  assert_true(encoded_settings.size > 0, "settings serialized non-empty")
  dec_dict = SettingsDictionary.decode(encoded_settings)
  assert_true(dec_dict.get(H3Setting::QPACK_MAX_TABLE_CAPACITY) == 4096_u64, "decoded table capacity")
  assert_true(dec_dict.get(H3Setting::ENABLE_CONNECT_PROTOCOL) == 1_u64, "decoded connect protocol")

  # H3 Frame Codec
  payload = Bytes.new(5, 0x41_u8)
  data_frame = H3FrameCodec.encode_frame(H3FrameType::DATA, payload)
  f_type, f_payload, f_consumed = H3FrameCodec.decode_frame(data_frame)
  assert_true(f_type == H3FrameType::DATA, "decoded frame type DATA")
  assert_true(f_consumed == data_frame.size, "decoded frame payload length 5")
end

# =============================================================================
# Section 5: QUIC (RFC 9000, RFC 9001, RFC 9002)
# =============================================================================
def test_quic : Nil
  puts "== Section 5: QUIC (RFC 9000, 9001, 9002)"

  # Version
  assert_true(QuicVersion.supported?(QuicVersion::V1), "QUIC V1 is supported")
  assert_true(!QuicVersion.supported?(QuicVersion::DRAFT_29), "QUIC draft-29 not supported")

  # RFC 9001 Appendix A.1 Keys Verification
  dcid = hex_to_bytes("8394c8f03e515708")
  c_sec, s_sec = QuicCrypto.derive_initial_secrets(dcid)
  c_keys = QuicCrypto.derive_keys(c_sec)
  s_keys = QuicCrypto.derive_keys(s_sec)
  assert_eq(bytes_to_hex(c_keys.key), "1f369613dd76d5467730efcbe3b1a22d", "client initial key matches RFC 9001 A.1")
  assert_eq(bytes_to_hex(c_keys.iv), "fa044b2f42a3fd3b46fb255c", "client initial iv matches RFC 9001 A.1")
  assert_eq(bytes_to_hex(c_keys.hp), "9f50449e04a0e810283a1e9933adedd2", "client initial hp matches RFC 9001 A.1")
  assert_eq(bytes_to_hex(s_keys.key), "cf3a5331653c364c88f0f379b6067e37", "server initial key matches RFC 9001 A.1")
  assert_eq(bytes_to_hex(s_keys.iv), "0ac1493ca1905853b0bba03e", "server initial iv matches RFC 9001 A.1")
  assert_eq(bytes_to_hex(s_keys.hp), "c206b8d9b9f0f37644430b490eeaa314", "server initial hp matches RFC 9001 A.1")

  # Packet Number reconstruction (RFC 9000 Appendix A.3)
  pn_dec = PacketNumber.decode(0xa82f30ea_u64, 0xac_u64, 8)
  assert_true(pn_dec == 0xa82f30ac_u64, "packet number decoding window arithmetic")

  # Transport parameters serialization & decoding
  tp = TransportParameters.new(initial_max_data: 1048576_u64, initial_max_streams_bidi: 100_u64)
  tp_bytes = tp.encode
  assert_true(tp_bytes.size > 0, "transport parameters serialized")
  dec_tp = TransportParameters.decode(tp_bytes)
  assert_true(dec_tp.initial_max_data == 1048576_u64, "decoded initial max data")
  assert_true(dec_tp.initial_max_streams_bidi == 100_u64, "decoded max streams bidi")
  # Loss detection & Congestion Control
  rtt = RttEstimator.new
  rtt.update(100_i64, 0_i64)
  assert_eq_i64(rtt.latest_rtt, 100_i64, "rtt estimator first sample")
  assert_eq_i64(rtt.smoothed_rtt, 100_i64, "rtt estimator smoothed rtt")

  cc = NewRenoCongestionController.new
  assert_eq_i64(cc.bytes_in_flight, 0_i64, "initial bytes in flight is 0")
  cc.on_packet_sent(1200)
  assert_eq_i64(cc.bytes_in_flight, 1200_i64, "bytes in flight after sent packet")
  cc.on_packet_acked(1200, 100_i64)
  assert_eq_i64(cc.bytes_in_flight, 0_i64, "bytes in flight after ack")
end

# =============================================================================
# Section 6: WebSocket (RFC 6455, full public surface)
# =============================================================================
def test_websocket : Nil
  puts "== Section 6: WebSocket (RFC 6455, full public surface)"

  # RFC 4648 Base64 vectors
  assert_eq(Base64.encode(hex_to_bytes("66")), "Zg==", "base64 'f'")
  assert_eq(Base64.encode(hex_to_bytes("666f")), "Zm8=", "base64 'fo'")
  assert_eq(Base64.encode(hex_to_bytes("666f6f")), "Zm9v", "base64 'foo'")

  # RFC 6455 Section 1.3 Accept vector
  accept = Handshake.compute_accept("dGhlIHNhbXBsZSBub25jZQ==")
  assert_eq(accept, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", "RFC 6455 1.3 Sec-WebSocket-Accept")

  # The whole CloseCode enum, every name it is meant to answer to
  assert_eq_i32(CloseCode::NormalClosure.to_i32, 1000, "CloseCode NormalClosure")
  assert_eq_i32(CloseCode::GoingAway.to_i32, 1001, "CloseCode GoingAway")
  assert_eq_i32(CloseCode::ProtocolError.to_i32, 1002, "CloseCode ProtocolError")
  assert_eq_i32(CloseCode::UnsupportedData.to_i32, 1003, "CloseCode UnsupportedData")
  assert_eq_i32(CloseCode::NoStatusReceived.to_i32, 1005, "CloseCode NoStatusReceived")
  assert_eq_i32(CloseCode::AbnormalClosure.to_i32, 1006, "CloseCode AbnormalClosure")
  assert_eq_i32(CloseCode::InvalidFramePayloadData.to_i32, 1007, "CloseCode InvalidFramePayloadData")
  assert_eq_i32(CloseCode::PolicyViolation.to_i32, 1008, "CloseCode PolicyViolation")
  assert_eq_i32(CloseCode::MessageTooBig.to_i32, 1009, "CloseCode MessageTooBig")
  assert_eq_i32(CloseCode::MandatoryExtension.to_i32, 1010, "CloseCode MandatoryExtension")
  assert_eq_i32(CloseCode::InternalServerError.to_i32, 1011, "CloseCode InternalServerError")
  assert_eq_i32(CloseCode::ServiceRestart.to_i32, 1012, "CloseCode ServiceRestart")
  assert_eq_i32(CloseCode::TryAgainLater.to_i32, 1013, "CloseCode TryAgainLater")
  assert_eq_i32(CloseCode::BadGateway.to_i32, 1014, "CloseCode BadGateway")
  assert_eq_i32(CloseCode::TLSHandshake.to_i32, 1015, "CloseCode TLSHandshake")

  # Memory transport session test
  c_to_s = MemoryTransport.new(16384)
  s_to_c = MemoryTransport.new(16384)
  c_sess = Session.new(c_to_s, is_server: false)
  s_sess = Session.new(s_to_c, is_server: true)

  # Frame construction and serialization
  payload_b = Bytes.new(5) { |i| "hello".to_unsafe[i] }
  mask_key = Bytes.new(4, 0x12_u8)
  frame = Frame.new(OP_TEXT, payload_b, fin: true, masked: true, mask_key: mask_key)
  wire = frame.serialize
  assert_true(wire.size > 0, "frame serialized to bytes")

  # In-memory WebSocket wrapper
  ws_client = WebSocket(MemoryTransport).new(c_sess)
  assert_true(!ws_client.closed?, "new websocket is open")
  # Rejection of unmasked client frame on server
  unmasked_f = Frame.new(OP_TEXT, payload_b, fin: true, masked: false)
  raw_unmasked = unmasked_f.serialize(masked_override: false)
  t_unmasked = MemoryTransport.new(1024)
  t_unmasked.write(raw_unmasked.to_unsafe, raw_unmasked.size)
  s_unmasked = Session.new(t_unmasked, is_server: true)
  unmasked_res = s_unmasked.receive
  assert_true(unmasked_res.is_a?(WebSocketError), "unmasked client frame was not rejected")
end

# =============================================================================
# Section 7: WebTransport (draft-ietf-webtrans-http3)
# =============================================================================
def test_webtransport : Nil
  puts "== Section 7: WebTransport (draft-ietf-webtrans-http3)"

  # Constants
  assert_true(WebTransportConstants::SETTINGS_ENABLE_CONNECT_PROTOCOL == 0x08_u64, "settings enable connect protocol")
  assert_true(WebTransportConstants::STREAM_TYPE_BIDI == 0x41_u64, "stream type bidi 0x41")
  assert_true(WebTransportConstants::STREAM_TYPE_UNI == 0x54_u64, "stream type uni 0x54")
  assert_true(WebTransportConstants::CAPSULE_CLOSE_SESSION == 0x2843_u64, "capsule close session 0x2843")
  assert_true(WebTransportConstants::CAPSULE_DRAIN_SESSION == 0x78ae_u64, "capsule drain session 0x78ae")

  # Bidi & Uni Stream headers
  bidi_h = BidiStreamHeader.new(8_u64)
  bidi_wire = bidi_h.encode
  dec_bidi, _ = BidiStreamHeader.decode(bidi_wire)
  assert_true(!dec_bidi.nil? && dec_bidi.session_id == 8_u64, "bidi stream header round-trip")

  uni_h = UniStreamHeader.new(8_u64)
  uni_wire = uni_h.encode
  dec_uni, _ = UniStreamHeader.decode(uni_wire)
  assert_true(!dec_uni.nil? && dec_uni.session_id == 8_u64, "uni stream header round-trip")

  # Close Session Capsule
  close_cap = CloseSessionCapsule.new(0x00_u64, "Session normal close")
  cap = close_cap.to_capsule
  assert_true(cap.close_webtransport_session?, "capsule recognized as close session")
  parsed_close = CloseSessionCapsule.decode(cap.value)
  assert_true(parsed_close.error_code == 0_u64, "decoded close error code")

  # Drain Session Capsule
  drain_cap = DrainSessionCapsule.to_capsule
  assert_true(drain_cap.drain_webtransport_session?, "capsule recognized as drain session")

  # WebTransport Session State Machine
  sess = WebTransportSession.new(4_u64)
  assert_true(sess.status == SessionStatus::CONNECTING, "initial session status CONNECTING")
  sess.on_connect_response(200)
  assert_true(sess.open?, "session status OPEN after 200 response")
  sess.drain
  assert_true(sess.draining?, "session status DRAINING after drain")
  sess.close(0_u64, "done")
  assert_true(sess.closed?, "session status CLOSED after close")
end

# =============================================================================
# Section 8: Capsule & HTTP Datagrams (RFC 9297)
# =============================================================================
def test_capsule : Nil
  puts "== Section 8: Capsule & HTTP Datagrams (RFC 9297)"

  # RFC 9000 Appendix A VarInt test vectors
  # 37 (1 byte)
  assert_eq(bytes_to_hex(VarInt.encode(37_u64, 1)), "25", "rfc9000 app a: 37 in 1 byte")
  val, len = VarInt.decode(hex_to_bytes("25"))
  assert_true(val == 37_u64 && len == 1, "decode 37 in 1 byte")

  # 15293 (2 bytes)
  assert_eq(bytes_to_hex(VarInt.encode(15293_u64, 2)), "7bbd", "rfc9000 app a: 15293 in 2 bytes")
  val2, len2 = VarInt.decode(hex_to_bytes("7bbd"))
  assert_true(val2 == 15293_u64 && len2 == 2, "decode 15293 in 2 bytes")

  # 494878333 (4 bytes)
  assert_eq(bytes_to_hex(VarInt.encode(494878333_u64, 4)), "9d7f3e7d", "rfc9000 app a: 494878333 in 4 bytes")

  # Boundary values
  assert_eq_i32(VarInt.encoded_size(0_u64), 1, "boundary 0 size")
  assert_eq_i32(VarInt.encoded_size(63_u64), 1, "boundary 63 size")
  assert_eq_i32(VarInt.encoded_size(64_u64), 2, "boundary 64 size")
  assert_eq_i32(VarInt.encoded_size(16383_u64), 2, "boundary 16383 size")
  assert_eq_i32(VarInt.encoded_size(16384_u64), 4, "boundary 16384 size")
  assert_eq_i32(VarInt.encoded_size(1073741823_u64), 4, "boundary 1073741823 size")
  assert_eq_i32(VarInt.encoded_size(1073741824_u64), 8, "boundary 1073741824 size")
  assert_eq_i32(VarInt.encoded_size(VarInt::MAX), 8, "boundary max size")

  # HttpDatagram
  dgram_payload = Bytes.new(4) { |i| (i + 1).to_u8 }
  dgram = HttpDatagram.new(2_u64, dgram_payload)
  assert_true(dgram.stream_id == 8_u64, "dgram stream_id 8")
  dgram_bytes = dgram.encode
  dec_dgram, _ = HttpDatagram.decode(dgram_bytes)
  assert_true(!dec_dgram.nil? && dec_dgram.quarter_stream_id == 2_u64, "decoded dgram quarter stream id")

  # Capsule encoding & decoding
  cap = Capsule.new(CapsuleType::DATAGRAM, dgram_payload)
  assert_true(cap.datagram?, "capsule is datagram")
  cap_wire = cap.encode
  caps = CapsuleReader.read_all(cap_wire)
  assert_eq_i32(caps.size, 1, "capsule reader decoded 1 capsule")
  assert_true(caps[0].capsule_type == CapsuleType::DATAGRAM, "decoded capsule type DATAGRAM")

  # CapsuleProtocol header
  assert_eq(CapsuleProtocol::HEADER_NAME, "Capsule-Protocol", "capsule protocol header name")
  assert_eq(CapsuleProtocol::HEADER_VALUE, "?1", "capsule protocol header value")
  assert_true(CapsuleProtocol.is_capsule_protocol_header?("?1"), "valid capsule protocol header ?1")
end

# =============================================================================
# Section 9: Real TCP Loopback: WebSocket Handshake & Echo
# =============================================================================
def test_loopback_websocket : Nil
  puts "== Section 9: Real TCP Loopback: WebSocket Handshake & Echo"

  server_sock = IyiSocket.listen(0)
  port = server_sock.local_port
  assert_true(port > 0, "server bound to ephemeral TCP port")

  client_sock = IyiSocket.connect("127.0.0.1", port)
  accepted_sock = server_sock.accept

  # WebSocket handshake
  key = Handshake.generate_key
  req = Handshake.build_client_request("/", "127.0.0.1:#{port}", key)
  ser_req = req.serialize
  case ser_req
  in String    then client_sock.write(ser_req)
  in HttpError then raise "failed to serialize client handshake"
  end

  raw_req = accepted_sock.read(4096)
  parsed_req = Request.parse(raw_req)
  case parsed_req
  in Request
    v_key = Handshake.verify_client_request(parsed_req)
    case v_key
    in String
      resp = Handshake.build_server_response(v_key)
      ser_resp = resp.serialize
      case ser_resp
      in String    then accepted_sock.write(ser_resp)
      in HttpError then raise "failed to serialize server response"
      end
    in WebSocketError
      raise "server verification failed"
    end
  in HttpError
    raise "request parse failed"
  end

  raw_resp = client_sock.read(4096)
  parsed_resp = Response.parse(raw_resp)
  case parsed_resp
  in Response
    h_err = Handshake.verify_server_response(parsed_resp, key)
    assert_true(h_err == false, "client verified server 101 switching protocols")
  in HttpError
    raise "response parse failed"
  end

  # Create WebSocket wrappers around live sockets
  client_sess = Session.new(client_sock, is_server: false)
  server_sess = Session.new(accepted_sock, is_server: true)
  ws_client = WebSocket(IyiSocket).new(client_sess)
  ws_server = WebSocket(IyiSocket).new(server_sess)

  # Send text over live loopback
  ws_client.send("Hello over real loopback TCP WebSocket!")
  msg = ws_server.receive
  case msg
  in Message
    assert_true(msg.text == "Hello over real loopback TCP WebSocket!", "server received live text")
  in WebSocketError, Nil
    raise "server failed to receive message"
  end

  # Echo response
  ws_server.send("Echo from server over loopback!")
  echo_msg = ws_client.receive
  case echo_msg
  in Message
    assert_true(echo_msg.text == "Echo from server over loopback!", "client received echo response")
  in WebSocketError, Nil
    raise "client failed to receive echo"
  end

  # Clean close
  ws_client.close(CloseCode::NormalClosure, "TCP loopback verified")
  s_close = ws_server.receive
  assert_true(s_close.nil?, "server closed on live close")
  assert_true(ws_server.closed?, "server is marked closed")
  server_sock.close
  puts "    pass: live TCP loopback WebSocket session cleanly completed"
end

# =============================================================================
# Section 10: Real TCP Loopback: HTTP/2 & HPACK Request & Response
# =============================================================================
def test_loopback_http2 : Nil
  puts "== Section 10: Real TCP Loopback: HTTP/2 & HPACK Request & Response"

  server_sock = IyiSocket.listen(0)
  port = server_sock.local_port
  assert_true(port > 0, "server bound to ephemeral TCP port for HTTP/2")

  client_sock = IyiSocket.connect("127.0.0.1", port)
  accepted_sock = server_sock.accept

  client = SocketClient.new(client_sock)
  server = SocketServer.new(accepted_sock)

  # Step handshake over TCP
  err1 = server.step
  assert_true(err1.nil?, "server stepped client preface")
  err2 = client.step
  assert_true(err2.nil?, "client stepped server settings")
  err3 = server.step
  assert_true(err3.nil?, "server stepped client settings ack")

  # Send HTTP/2 request with HPACK-compressed headers and DATA payload
  req_hdrs = Headers.new
  req_hdrs.add("content-type", "application/json")
  h2_req = Request.new("POST", "/api/parity", req_hdrs, "{\"hpack\":\"verified\"}")

  stream_id, err_req = client.send_request(h2_req)
  assert_true(err_req.nil?, "client sent HTTP/2 request")

  # Server receives request
  err_s_step = server.step
  assert_true(err_s_step.nil?, "server received request frame")
  rec_req = server.get_request(stream_id)
  assert_true(!rec_req.nil?, "server parsed HTTP/2 request")
  if r = rec_req
    assert_eq(r.method, "POST", "server request method matches")
    assert_eq(r.target, "/api/parity", "server request target matches")
    assert_eq(r.body, "{\"hpack\":\"verified\"}", "server request body matches")
  end

  # Server responds
  res_hdrs = Headers.new
  res_hdrs.add("content-type", "application/json")
  h2_res = Response.new(Status::OK, res_hdrs, "{\"status\":\"ok\"}")
  err_res = server.send_response(stream_id, h2_res)
  assert_true(err_res.nil?, "server sent response")

  # Client receives response
  err_c_step = client.step
  assert_true(err_c_step.nil?, "client received response frame")
  rec_res = client.get_response(stream_id)
  if rec_res.nil?
    client.step
    rec_res = client.get_response(stream_id)
  end
  assert_true(!rec_res.nil?, "client parsed HTTP/2 response")
  if res_obj = rec_res
    assert_eq(res_obj.body, "{\"status\":\"ok\"}", "client received 200 response body")
  end

  client.close
  server.close
  server_sock.close
  puts "    pass: live TCP loopback HTTP/2 and HPACK exchange verified"
end

# =============================================================================
# Section 11: Real UDP Loopback: QUIC Handshake, 1-RTT & Stream Transfer
# =============================================================================
def make_test_credentials : Tuple(Std::Tls::CertificateStore, QuicServerCredentials)
  p1 = ""
  p2 = ""
  test_cert_der = hex_to_bytes(p1 + p2)
  test_cert = Std::Tls::Certificate.parse(test_cert_der)
  raise "test certificate parse failed" if test_cert.nil?
  store = Std::Tls::CertificateStore.new
  store.add_certificate(test_cert)
  creds = QuicServerCredentials.new(
    [test_cert_der],
    BigInt.from_hex("b4bb498f8279303d980836399b36c6988c0c68de55e1bdb826d3901a2461eafd2de49a91d015abbc9a95137ace6c1af19eaa6af98c7ced43120998e187a80ee0ccb0524b1b018c3e0b63264d449a6d38e22a5fda430846748030530ef0461c8ca9d9efbfae8ea6d1d03e2bd193eff0ab9a8002c47428a6d35a8d88d79f7f1e3f"),
    BigInt.from_hex("04dea705d43a6ea7209dd8072111a83c81e322a59278b33480641eaf7c0a6985b8e31c44f6de62e1b4c2309f6126e77b7c41e923314bbfa3881305dc1217f16c819ce538e922f369828d0e57195d8c8488460207b2faa726bcf708bbd7db7f679f893492fc2a622e08970aac441ce4e0c3088df25ae679233df8a3bda2ff9941")
  )
  {store, creds}
end

def test_loopback_quic : Nil
  puts "== Section 11: Real UDP Loopback: QUIC Handshake, 1-RTT & Stream Transfer"

  ca_store, creds = make_test_credentials
  cid = hex_to_bytes("8394c8f03e515708")
  server_ep = QuicEndpoint.new("127.0.0.1", 0)
  client_ep = QuicEndpoint.new("127.0.0.1", 0)
  server_port = server_ep.local_port
  client_port = client_ep.local_port

  client_conn = QuicConnection.new(ConnectionRole::CLIENT, cid, hex_to_bytes("0102030405060708"), hostname: "rsa", ca_store: ca_store, verification_time: 1577836800_i64)
  server_conn = QuicConnection.new(ConnectionRole::SERVER, hex_to_bytes("0102030405060708"), cid, initial_dcid: cid, hostname: "rsa", server_credentials: creds)
  client_conn.set_remote("127.0.0.1", server_port)
  server_conn.set_remote("127.0.0.1", client_port)
  client_ep.add_connection(client_conn)
  server_ep.add_connection(server_conn)

  # Handshake
  client_conn.start_client_handshake
  c_init_packet = client_conn.send_initial_packet(current_time: 1000_i64)
  client_ep.send_to(c_init_packet, "127.0.0.1", server_port)
  server_ep.step(1010_i64)

  s_init_packet = server_conn.send_initial_packet(FrameCodec.encode_ack(0_u64, 5_u64, 0_u64), current_time: 1010_i64)
  server_ep.send_to(s_init_packet, "127.0.0.1", client_port)
  s_hs_packet = server_conn.send_handshake_packet(FrameCodec.encode_ping, current_time: 1010_i64)
  server_ep.send_to(s_hs_packet, "127.0.0.1", client_port)

  client_ep.step(1020_i64)
  assert_true(client_conn.tls.cert_verified, "client TLS verified server certificate")

  c_hs_packet = client_conn.send_handshake_packet(FrameCodec.encode_ack(0_u64, 5_u64, 0_u64), current_time: 1020_i64)
  client_ep.send_to(c_hs_packet, "127.0.0.1", server_port)
  server_ep.step(1030_i64)
  assert_true(server_conn.tls.handshake_done, "server handshake completed")

  # 1-RTT Stream Transfer over UDP loopback
  req_payload = hex_to_bytes("48656c6c6f2051554943206f76657220554450")
  stream_pkt = client_conn.send_1rtt_packet(FrameCodec.encode_stream(0_u64, 0_u64, req_payload, fin: true), current_time: 1040_i64)
  b_in_flight_before = client_conn.bytes_in_flight
  assert_true(b_in_flight_before > 0_i64, "bytes in flight increased on send")

  client_ep.send_to(stream_pkt, "127.0.0.1", server_port)
  server_ep.step(1045_i64)
  rx_stream = server_conn.stream_manager.get_or_create_stream(0_u64)
  rx_bytes = rx_stream.read_available
  assert_bytes_equal(rx_bytes, req_payload, "server received 1-RTT stream payload over loopback UDP")

  s_ack_pkt = server_conn.send_1rtt_packet(FrameCodec.encode_ack(0_u64, 5_u64, 0_u64), current_time: 1045_i64)
  server_ep.send_to(s_ack_pkt, "127.0.0.1", client_port)

  client_ep.step(1050_i64)
  b_in_flight_after = client_conn.bytes_in_flight
  assert_true(b_in_flight_after < b_in_flight_before, "bytes in flight reduced by ACK")

  client_ep.close
  server_ep.close
  puts "    pass: live UDP loopback QUIC handshake, 1-RTT, and stream transfer verified"
end

# =============================================================================
# Section 12: Real UDP Loopback: HTTP/3, QPACK, WebTransport & Capsules
# =============================================================================
def test_loopback_h3_webtransport : Nil
  puts "== Section 12: Real UDP Loopback: HTTP/3, QPACK, WebTransport & Capsules"

  ca_store, creds = make_test_credentials
  cid = hex_to_bytes("8394c8f03e515708")
  server_ep = QuicEndpoint.new("127.0.0.1", 0)
  client_ep = QuicEndpoint.new("127.0.0.1", 0)
  server_port = server_ep.local_port
  client_port = client_ep.local_port

  client_conn = QuicConnection.new(ConnectionRole::CLIENT, cid, hex_to_bytes("0102030405060708"), hostname: "rsa", ca_store: ca_store, verification_time: 1577836800_i64)
  server_conn = QuicConnection.new(ConnectionRole::SERVER, hex_to_bytes("0102030405060708"), cid, initial_dcid: cid, hostname: "rsa", server_credentials: creds)
  client_conn.set_remote("127.0.0.1", server_port)
  server_conn.set_remote("127.0.0.1", client_port)
  client_ep.add_connection(client_conn)
  server_ep.add_connection(server_conn)

  client_conn.start_client_handshake
  client_ep.send_to(client_conn.send_initial_packet(current_time: 2000_i64), "127.0.0.1", server_port)
  server_ep.step(2010_i64)

  s_init_pkt = server_conn.send_initial_packet(FrameCodec.encode_ack(0_u64, 5_u64, 0_u64), current_time: 2010_i64)
  server_ep.send_to(s_init_pkt, "127.0.0.1", client_port)
  s_hs_pkt = server_conn.send_handshake_packet(FrameCodec.encode_ping, current_time: 2010_i64)
  server_ep.send_to(s_hs_pkt, "127.0.0.1", client_port)

  client_ep.step(2020_i64)
  c_hs_pkt = client_conn.send_handshake_packet(FrameCodec.encode_ack(0_u64, 5_u64, 0_u64), current_time: 2020_i64)
  client_ep.send_to(c_hs_pkt, "127.0.0.1", server_port)
  server_ep.step(2030_i64)

  # HTTP/3 Sessions
  client_h3 = H3Session.new(ConnectionRole::CLIENT)
  server_h3 = H3Session.new(ConnectionRole::SERVER)

  # 1. Exchange Control Streams (SETTINGS) over UDP
  c_ctrl_wire = client_h3.open_control_stream
  s_ctrl_wire = server_h3.open_control_stream
  client_ep.send_to(client_conn.send_1rtt_packet(FrameCodec.encode_stream(2_u64, 0_u64, c_ctrl_wire, fin: false), current_time: 2040_i64), "127.0.0.1", server_port)
  server_ep.send_to(server_conn.send_1rtt_packet(FrameCodec.encode_stream(3_u64, 0_u64, s_ctrl_wire, fin: false), current_time: 2040_i64), "127.0.0.1", client_port)
  server_ep.step(2045_i64)
  client_ep.step(2045_i64)

  s_uni_2 = server_conn.stream_manager.get_or_create_stream(2_u64)
  c_uni_3 = client_conn.stream_manager.get_or_create_stream(3_u64)
  err_sc = server_h3.process_uni_stream(2_u64, s_uni_2.read_available)
  err_cs = client_h3.process_uni_stream(3_u64, c_uni_3.read_available)
  assert_true(err_sc == H3Error::NO_ERROR, "server accepted client HTTP/3 SETTINGS")
  assert_true(err_cs == H3Error::NO_ERROR, "client accepted server HTTP/3 SETTINGS")

  # 2. HTTP/3 Request & Response with QPACK over loopback QUIC UDP
  h3_req_body = hex_to_bytes("7b226f72646572223a22313233227d") # {"order":"123"}
  h3_req = H3Request.build("POST", "/v1/orders", "api.quic.org", [FieldLine.new("content-type", "application/json")], h3_req_body)
  h3_req_wire = client_h3.frame_request(4_u64, h3_req)
  client_ep.send_to(client_conn.send_1rtt_packet(FrameCodec.encode_stream(4_u64, 0_u64, h3_req_wire, fin: true), current_time: 2050_i64), "127.0.0.1", server_port)

  server_ep.step(2055_i64)
  s_req_stream = server_conn.stream_manager.get_or_create_stream(4_u64)
  s_fields, s_body, s_err = server_h3.parse_stream(4_u64, s_req_stream.read_available)
  assert_true(s_err == H3Error::NO_ERROR, "server parsed HTTP/3 request")
  assert_bytes_equal(s_body, h3_req_body, "server received HTTP/3 request body")

  h3_res_body = hex_to_bytes("7b22737461747573223a2263726561746564227d")
  h3_res = H3Response.build(201, [FieldLine.new("content-type", "application/json")], h3_res_body)
  h3_res_wire = server_h3.frame_response(4_u64, h3_res)
  server_ep.send_to(server_conn.send_1rtt_packet(FrameCodec.encode_stream(4_u64, 0_u64, h3_res_wire, fin: true), current_time: 2060_i64), "127.0.0.1", client_port)

  client_ep.step(2065_i64)
  c_res_stream = client_conn.stream_manager.get_or_create_stream(4_u64)
  c_fields, c_body, c_err = client_h3.parse_stream(4_u64, c_res_stream.read_available)
  assert_true(c_err == H3Error::NO_ERROR, "client parsed HTTP/3 response")
  assert_bytes_equal(c_body, h3_res_body, "client received HTTP/3 201 response body")

  # 3. WebTransport Extended CONNECT over UDP loopback
  wt_req = H3Request.build_extended_connect("webtransport", "api.quic.org", "/wt")
  wt_req_wire = client_h3.frame_request(8_u64, wt_req)
  client_ep.send_to(client_conn.send_1rtt_packet(FrameCodec.encode_stream(8_u64, 0_u64, wt_req_wire, fin: false), current_time: 2070_i64), "127.0.0.1", server_port)

  server_ep.step(2075_i64)
  s_wt_stream = server_conn.stream_manager.get_or_create_stream(8_u64)
  s_wt_fields, _, s_wt_err = server_h3.parse_stream(8_u64, s_wt_stream.read_available)
  assert_true(s_wt_err == H3Error::NO_ERROR, "server received Extended CONNECT")
  server_wt = server_h3.create_webtransport_session(8_u64)
  server_wt.on_connect_response(200)

  # Server answers 200 OK
  wt_res = H3Response.build(200, [FieldLine.new(":status", "200")], Bytes.empty)
  server_ep.send_to(server_conn.send_1rtt_packet(FrameCodec.encode_stream(8_u64, 0_u64, server_h3.frame_response(8_u64, wt_res), fin: false), current_time: 2080_i64), "127.0.0.1", client_port)

  client_ep.step(2085_i64)
  client_wt = client_h3.create_webtransport_session(8_u64)
  client_wt.on_connect_response(200)
  assert_true(client_wt.open? && server_wt.open?, "WebTransport sessions established on both ends")

  # 4. WebTransport Bidi Stream over loopback
  bidi_payload = hex_to_bytes("7765627472616e73706f72742d64617461") # "webtransport-data"
  bidi_header = client_wt.create_bidi_stream
  bidi_stream_bytes = Bytes.new(bidi_header.size + bidi_payload.size)
  bidi_stream_bytes.to_unsafe.copy_from(bidi_header.to_unsafe, bidi_header.size)
  (bidi_stream_bytes.to_unsafe + bidi_header.size).copy_from(bidi_payload.to_unsafe, bidi_payload.size)

  client_ep.send_to(client_conn.send_1rtt_packet(FrameCodec.encode_stream(12_u64, 0_u64, bidi_stream_bytes, fin: true), current_time: 2090_i64), "127.0.0.1", server_port)
  server_ep.step(2095_i64)
  s_bidi_stream = server_conn.stream_manager.get_or_create_stream(12_u64)
  s_bidi_rx = s_bidi_stream.read_available
  assert_true(s_bidi_rx.size >= bidi_header.size, "server received bidi stream")
  dec_bidi_h, bidi_offset = BidiStreamHeader.decode(s_bidi_rx)
  assert_true(!dec_bidi_h.nil? && dec_bidi_h.session_id == 8_u64, "bidi stream matches session ID 8")

  # 5. WebTransport Datagram over loopback
  dgram_payload = hex_to_bytes("646174616772616d") # "datagram"
  client_dgram = client_wt.send_datagram(dgram_payload)
  client_ep.send_to(client_conn.send_1rtt_packet(FrameCodec.encode_datagram(client_dgram), current_time: 2100_i64), "127.0.0.1", server_port)

  server_ep.step(2105_i64)
  # Process datagram frame
  s_dgram_res = server_wt.receive_datagram(client_dgram)
  assert_bytes_equal(s_dgram_res, dgram_payload, "server received WebTransport datagram payload")

  # 6. Capsule Protocol: Close WebTransport Session Capsule
  close_capsule = CloseSessionCapsule.new(0x00_u64, "clean close")
  close_cap_wire = close_capsule.to_capsule.encode
  client_ep.send_to(client_conn.send_1rtt_packet(FrameCodec.encode_stream(8_u64, wt_req_wire.size.to_u64, close_cap_wire, fin: true), current_time: 2110_i64), "127.0.0.1", server_port)

  server_ep.step(2115_i64)
  s_close_caps = CapsuleReader.read_all(close_cap_wire)
  assert_eq_i32(s_close_caps.size, 1, "server read close session capsule")
  server_wt.process_capsule(s_close_caps[0])
  assert_true(server_wt.closed?, "server WebTransport session closed via capsule")

  client_ep.close
  server_ep.close
  puts "    pass: live UDP loopback HTTP/3, QPACK, WebTransport and Capsule exchange verified"
end

# =============================================================================
# Main
# =============================================================================
def main : Nil
  test_hpack
  test_qpack
  test_http2
  test_http3
  test_quic
  test_websocket
  test_webtransport
  test_capsule
  test_loopback_websocket
  test_loopback_http2
  test_loopback_quic
  test_loopback_h3_webtransport

  puts "all std/network_advanced_parity checks passed"
end

main
