# Compression standard library exercise.
#
#   ./bin/iyi run bench/std_compress_exercise.iyi
#
# Exercises the entire std/compress surface:
#   - Adler-32 and CRC-32 checksums against known RFC/ISO test vectors
#   - Deflate Level 0 (Stored blocks): empty, small, and multi-chunk (>64KB)
#   - Deflate Level 1 (Fixed Huffman): text, single byte runs, alphabet patterns
#   - Deflate Levels 2..9 (Dynamic Huffman): LZ77 match finder, optimal canonical
#     tree length-limiting, RLE tree coding, across text, repetitive, and random inputs
#   - Zlib wrapper (RFC 1950): CMF/FLG framing, big-endian Adler-32 verification
#   - Gzip wrapper (RFC 1952): 10-byte header, little-endian CRC-32 and ISIZE verification
#   - Cross-implementation: decodes stored, fixed, and dynamic Huffman streams
#     and zlib/gzip containers generated by standard reference zlib.
#
# Every section prints a progress line and raises on mismatch.

module bench/std_compress_exercise

import std/slice
using std/slice::{Slice}

import std/compress
using std/compress::{Deflate, Inflate, Zlib, Gzip, Adler32, CRC32, DecompressError, DecompressLimitExceeded}

alias Bytes = Std::Slice::Bytes

def make_bytes(size : Int32, &block : Int32 -> UInt8) : Bytes
  b = Slice(UInt8).new(size, 0_u8)
  i = 0
  while i < size
    b[i] = yield i
    i = i + 1
  end
  b
end

def main : Nil
  # ---------------------------------------------------------------------------
  # 1. Checksums: Adler-32 (RFC 1950) and CRC-32 (ISO 3309 / RFC 1952)
  # ---------------------------------------------------------------------------
  empty_bytes = Slice(UInt8).new(0, 0_u8)
  raise "adler32: empty" unless Adler32.checksum(empty_bytes) == 1_u64
  raise "crc32: empty" unless CRC32.checksum(empty_bytes) == 0_u64

  # "a" (ASCII 97)
  a_bytes = make_bytes(1) { 97_u8 }
  raise "adler32: single 'a'" unless Adler32.checksum(a_bytes) == 6422626_u64 # 0x00620062
  raise "crc32: single 'a'" unless CRC32.checksum(a_bytes) == 3904355907_u64  # 0xE8B7BE43

  # "123456789"
  digits = make_bytes(9) { |i| (49 + i).to_u8 }
  raise "adler32: 123456789" unless Adler32.checksum(digits) == 152961502_u64 # 0x091E01DE
  raise "crc32: 123456789" unless CRC32.checksum(digits) == 3421780262_u64    # 0xCBF43926

  # "Wikipedia"
  wiki_str = "Wikipedia"
  wiki_bytes = make_bytes(wiki_str.bytesize) { |i| wiki_str[i].ord.to_u8 }
  raise "adler32: Wikipedia" unless Adler32.checksum(wiki_bytes) == 300286872_u64 # 0x11E60398
  raise "crc32: Wikipedia" unless CRC32.checksum(wiki_bytes) == 2913648686_u64    # 0xADA4F72E

  puts "    checksums: adler32 and crc32 verified against standard vectors"

  # ---------------------------------------------------------------------------
  # 2. DEFLATE Stored Blocks (Level 0)
  # ---------------------------------------------------------------------------
  # Empty input
  s_empty = Deflate.compress(empty_bytes, 0)
  raise "deflate stored: empty roundtrip" unless Inflate.decompress(s_empty) == empty_bytes

  # Short text
  s_data = make_bytes(13) { |i| ("Hello, World!"[i]).ord.to_u8 }
  s_comp = Deflate.compress(s_data, 0)
  # Stored block format: 1 byte header (BFINAL=1, BTYPE=00) + 2 bytes LEN + 2 bytes NLEN + 13 bytes data = 18 bytes
  raise "deflate stored: header size" unless s_comp.size == 18
  raise "deflate stored: payload roundtrip" unless Inflate.decompress(s_comp) == s_data

  # Large multi-chunk input (> 65535 bytes) to exercise 16-bit block boundaries
  multi_size = 70000
  multi_data = make_bytes(multi_size) { |i| ((i * 7 + 13) & 0xFF).to_u8 }
  multi_comp = Deflate.compress(multi_data, 0)
  # 70000 bytes splits into 65535 + 4465 = 2 blocks, each having 5 bytes header -> 70010 bytes
  raise "deflate stored: multi-chunk size" unless multi_comp.size == 70010
  raise "deflate stored: multi-chunk roundtrip" unless Inflate.decompress(multi_comp) == multi_data

  puts "    deflate stored: level 0 uncompressed blocks verified"

  # ---------------------------------------------------------------------------
  # 3. DEFLATE Fixed Huffman Blocks (Level 1)
  # ---------------------------------------------------------------------------
  f_empty = Deflate.compress(empty_bytes, 1)
  raise "deflate fixed: empty roundtrip" unless Inflate.decompress(f_empty) == empty_bytes

  f_data = make_bytes(13) { |i| ("Hello, World!"[i]).ord.to_u8 }
  f_comp = Deflate.compress(f_data, 1)
  raise "deflate fixed: text roundtrip" unless Inflate.decompress(f_comp) == f_data

  # Repeated character run (exercises LZ77 length/distance matches in fixed Huffman)
  f_rep = make_bytes(500) { 65_u8 }
  f_rep_comp = Deflate.compress(f_rep, 1)
  raise "deflate fixed: rep roundtrip" unless Inflate.decompress(f_rep_comp) == f_rep
  raise "deflate fixed: rep compression" unless f_rep_comp.size < 50

  puts "    deflate fixed: level 1 fixed huffman verified"

  # ---------------------------------------------------------------------------
  # 4. DEFLATE Dynamic Huffman Blocks (Levels 2..9)
  # ---------------------------------------------------------------------------
  d_empty = Deflate.compress(empty_bytes, 6)
  raise "deflate dynamic: empty roundtrip" unless Inflate.decompress(d_empty) == empty_bytes

  # Level 2 (fast dynamic), Level 6 (default), Level 9 (max chain)
  text_sample = "The quick brown fox jumps over the lazy dog. Repetition enables compression! "
  text_data = make_bytes(text_sample.bytesize * 15) do |i|
    text_sample[i % text_sample.bytesize].ord.to_u8
  end

  d_comp2 = Deflate.compress(text_data, 2)
  raise "deflate dynamic: level 2 roundtrip" unless Inflate.decompress(d_comp2) == text_data

  d_comp6 = Deflate.compress(text_data, 6)
  raise "deflate dynamic: level 6 roundtrip" unless Inflate.decompress(d_comp6) == text_data

  d_comp9 = Deflate.compress(text_data, 9)
  raise "deflate dynamic: level 9 roundtrip" unless Inflate.decompress(d_comp9) == text_data

  # Highly repetitive large buffer (10,000 bytes) -> checks 32KB window and max match length 258
  large_rep = make_bytes(10000) { |i| (65 + (i % 5)).to_u8 }
  large_comp = Deflate.compress(large_rep, 6)
  raise "deflate dynamic: large rep roundtrip" unless Inflate.decompress(large_comp) == large_rep
  raise "deflate dynamic: large rep ratio" unless large_comp.size < 100

  # Incompressible pseudo-random data
  # LCG pseudo-random sequence
  rand_size = 1500
  rand_data = make_bytes(rand_size) do |i|
    # LCG: next = (prev * 1103515245 + 12345) & 0x7FFFFFFF
    # deterministic byte sequence
    seed = ((i.to_i64 * 1664525_i64 + 1013904223_i64) & 0xFF_i64).to_u8
    seed
  end
  rand_comp = Deflate.compress(rand_data, 6)
  raise "deflate dynamic: random roundtrip" unless Inflate.decompress(rand_comp) == rand_data

  puts "    deflate dynamic: levels 2..9 dynamic huffman and lz77 verified"

  # ---------------------------------------------------------------------------
  # 5. Zlib Wrapper (RFC 1950)
  # ---------------------------------------------------------------------------
  z_empty = Zlib.compress(empty_bytes, 6)
  # RFC 1950 zlib of empty data: 2 bytes header + 2 bytes empty deflate + 4 bytes adler(1) = 8 bytes
  raise "zlib: empty size" unless z_empty.size == 8
  raise "zlib: empty roundtrip" unless Zlib.decompress(z_empty) == empty_bytes

  z_text = Zlib.compress(text_data, 6)
  # Verify header check rule: (CMF * 256 + FLG) % 31 == 0
  cmf = z_text[0].to_i32
  flg = z_text[1].to_i32
  raise "zlib: header check formula" unless ((cmf * 256 + flg) % 31) == 0
  raise "zlib: cm method 8" unless (cmf & 0x0F) == 8

  # Verify Adler-32 in footer matches
  adler_expected = Adler32.checksum(text_data)
  footer_pos = z_text.size - 4
  adler_actual = (z_text[footer_pos].to_u64.unsafe_shl(24)) |
                 (z_text[footer_pos + 1].to_u64.unsafe_shl(16)) |
                 (z_text[footer_pos + 2].to_u64.unsafe_shl(8)) |
                 z_text[footer_pos + 3].to_u64
  raise "zlib: footer adler32" unless adler_actual == adler_expected

  z_dec = Zlib.decompress(z_text)
  raise "zlib: payload roundtrip" unless z_dec == text_data

  puts "    zlib wrapper: rfc 1950 framing and adler32 verified"

  # ---------------------------------------------------------------------------
  # 6. Gzip Wrapper (RFC 1952)
  # ---------------------------------------------------------------------------
  gz_empty = Gzip.compress(empty_bytes, 6)
  # 10 bytes header + 2 bytes deflate + 8 bytes footer = 20 bytes
  raise "gzip: empty size" unless gz_empty.size == 20
  raise "gzip: empty roundtrip" unless Gzip.decompress(gz_empty) == empty_bytes

  gz_text = Gzip.compress(text_data, 6)
  # Verify gzip header magic
  raise "gzip: magic id1" unless gz_text[0] == 0x1F_u8
  raise "gzip: magic id2" unless gz_text[1] == 0x8B_u8
  raise "gzip: cm 8" unless gz_text[2] == 8_u8

  # Verify CRC-32 and ISIZE in footer
  crc_expected = CRC32.checksum(text_data)
  isize_expected = (text_data.size.to_u64) & 0xFFFFFFFF_u64
  gz_footer = gz_text.size - 8
  crc_actual = gz_text[gz_footer].to_u64 |
               (gz_text[gz_footer + 1].to_u64.unsafe_shl(8)) |
               (gz_text[gz_footer + 2].to_u64.unsafe_shl(16)) |
               (gz_text[gz_footer + 3].to_u64.unsafe_shl(24))

  isize_actual = gz_text[gz_footer + 4].to_u64 |
                 (gz_text[gz_footer + 5].to_u64.unsafe_shl(8)) |
                 (gz_text[gz_footer + 6].to_u64.unsafe_shl(16)) |
                 (gz_text[gz_footer + 7].to_u64.unsafe_shl(24))

  raise "gzip: footer crc32" unless crc_actual == crc_expected
  raise "gzip: footer isize" unless isize_actual == isize_expected

  gz_dec = Gzip.decompress(gz_text)
  raise "gzip: payload roundtrip" unless gz_dec == text_data

  puts "    gzip wrapper: rfc 1952 framing and crc32 verified"

  # ---------------------------------------------------------------------------
  # 7. Cross-Implementation Reference Vectors (produced by standard zlib/gzip)
  # ---------------------------------------------------------------------------
  # Vector A: Stored block produced by standard zlib for "Hello"
  # [1, 5, 0, 250, 255, 72, 101, 108, 108, 111]
  stored_vec = [1, 5, 0, 250, 255, 72, 101, 108, 108, 111]
  stored_bytes = make_bytes(stored_vec.size) { |i| stored_vec[i].to_u8 }
  stored_dec = Inflate.decompress(stored_bytes)
  expected_hello = make_bytes(5) { |i| ("Hello"[i]).ord.to_u8 }
  raise "cross: stored vector mismatch" unless stored_dec == expected_hello

  # Vector B: Fixed Huffman block produced by standard zlib for "Hello, World!"
  fixed_vec = [243, 72, 205, 201, 201, 215, 81, 8, 207, 47, 202, 73, 81, 4, 0]
  fixed_bytes = make_bytes(fixed_vec.size) { |i| fixed_vec[i].to_u8 }
  fixed_dec = Inflate.decompress(fixed_bytes)
  expected_hw = make_bytes(13) { |i| ("Hello, World!"[i]).ord.to_u8 }
  raise "cross: fixed vector mismatch" unless fixed_dec == expected_hw

  # Vector C: Dynamic Huffman block produced by standard zlib (116 bytes -> 1360 bytes)
  dyn_vec = [
    237, 206, 209, 13, 194, 48, 12, 4, 208, 85, 110, 2, 230, 96, 128, 46, 96, 53, 103, 106,
    209, 56, 149, 99, 160, 108, 79, 212, 45, 144, 34, 249, 235, 124, 182, 222, 178, 89, 199, 24,
    193, 222, 252, 193, 64, 242, 76, 228, 38, 137, 77, 250, 8, 179, 163, 41, 130, 7, 37, 89,
    240, 105, 81, 70, 219, 11, 222, 18, 54, 130, 157, 153, 140, 142, 108, 168, 242, 36, 202, 215,
    165, 218, 138, 251, 75, 181, 138, 35, 131, 236, 168, 45, 8, 170, 218, 106, 244, 235, 191, 67,
    237, 28, 247, 215, 254, 134, 101, 58, 166, 99, 58, 166, 227, 207, 29, 63,
  ]
  dyn_bytes = make_bytes(dyn_vec.size) { |i| dyn_vec[i].to_u8 }
  dyn_dec = Inflate.decompress(dyn_bytes)
  raise "cross: dynamic vector size mismatch" unless dyn_dec.size == 1360

  # Vector D: Standard zlib container produced by Python zlib for "iyi native zlib compression"
  zlib_vec = [
    120, 156, 203, 172, 204, 84, 200, 75, 44, 201, 44, 75, 85, 168, 202, 201, 76, 82, 72,
    206, 207, 45, 40, 74, 45, 46, 206, 204, 207, 3, 0, 144, 203, 10, 150,
  ]
  zlib_bytes = make_bytes(zlib_vec.size) { |i| zlib_vec[i].to_u8 }
  zlib_dec = Zlib.decompress(zlib_bytes)
  expected_zstr = "iyi native zlib compression"
  expected_zbytes = make_bytes(expected_zstr.bytesize) { |i| expected_zstr[i].ord.to_u8 }
  raise "cross: zlib vector mismatch" unless zlib_dec == expected_zbytes

  # Vector E: Standard gzip container produced by system gzip for "iyi native gzip compression"
  gzip_vec = [
    31, 139, 8, 0, 0, 0, 0, 0, 2, 255, 203, 172, 204, 84, 200, 75, 44, 201, 44, 75, 85,
    72, 175, 202, 44, 80, 72, 206, 207, 45, 40, 74, 45, 46, 206, 204, 207, 3, 0, 203,
    178, 247, 59, 27, 0, 0, 0,
  ]
  gzip_bytes = make_bytes(gzip_vec.size) { |i| gzip_vec[i].to_u8 }
  gzip_dec = Gzip.decompress(gzip_bytes)
  expected_gstr = "iyi native gzip compression"
  expected_gbytes = make_bytes(expected_gstr.bytesize) { |i| expected_gstr[i].ord.to_u8 }
  raise "cross: gzip vector mismatch" unless gzip_dec == expected_gbytes

  puts "    cross-implementation: external zlib and gzip vectors decoded cleanly"

  # ---------------------------------------------------------------------------
  # 8. Bounded Decompression and Contract Guarantees
  # ---------------------------------------------------------------------------
  # Valid stored, fixed, and dynamic blocks under limit
  r_valid_stored = Inflate.decompress(s_comp, 100_i64)
  case r_valid_stored
  when Bytes
    raise "bounded: valid stored mismatch" unless r_valid_stored == s_data
  else
    raise "bounded: expected Bytes for valid stored block"
  end

  r_valid_fixed = Inflate.decompress(f_comp, 100_i64)
  case r_valid_fixed
  when Bytes
    raise "bounded: valid fixed mismatch" unless r_valid_fixed == f_data
  else
    raise "bounded: expected Bytes for valid fixed block"
  end

  r_valid_dyn = Inflate.decompress(d_comp6, 2000_i64)
  case r_valid_dyn
  when Bytes
    raise "bounded: valid dynamic mismatch" unless r_valid_dyn == text_data
  else
    raise "bounded: expected Bytes for valid dynamic block"
  end

  # Independent limit-overflow case 1: Stored block overflow (vector: 01 05 00 fa ff 48 65 6c 6c 6f with limit 3)
  stored_vec_bytes = make_bytes(10) { |i| stored_vec[i].to_u8 }
  r_stored_lim = Inflate.decompress(stored_vec_bytes, 3_i64)
  case r_stored_lim
  when DecompressLimitExceeded
    raise "stored limit mismatch" unless r_stored_lim.limit == 3_i64
    raise "stored produced mismatch" unless r_stored_lim.produced == 3_i64
  else
    raise "expected DecompressLimitExceeded for stored limit overflow"
  end

  # Independent limit-overflow case 2: Fixed-Huffman literal overflow (vector: f3 48 cd c9 c9 07 00 with limit 2)
  fixed_lit_raw = [0xF3_u8, 0x48_u8, 0xCD_u8, 0xC9_u8, 0xC9_u8, 0x07_u8, 0x00_u8]
  fixed_lit_bytes = make_bytes(7) { |i| fixed_lit_raw[i] }
  r_fixed_lim = Inflate.decompress(fixed_lit_bytes, 2_i64)
  case r_fixed_lim
  when DecompressLimitExceeded
    raise "fixed literal limit mismatch" unless r_fixed_lim.limit == 2_i64
    raise "fixed literal produced mismatch" unless r_fixed_lim.produced == 2_i64
  else
    raise "expected DecompressLimitExceeded for fixed literal limit overflow"
  end

  # Independent limit-overflow case 3: LZ77 back-reference copy overflow (bomb with limit 75)
  bomb_raw = make_bytes(10000) { 65_u8 }
  bomb_comp = Deflate.compress(bomb_raw, 6)
  bomb_lim = 75_i64
  r_bomb = Inflate.decompress(bomb_comp, bomb_lim)
  case r_bomb
  when DecompressLimitExceeded
    raise "bomb limit mismatch" unless r_bomb.limit == bomb_lim
    raise "bomb produced mismatch" unless r_bomb.produced == bomb_lim
  else
    raise "expected DecompressLimitExceeded for match limit overflow"
  end
  # Malformed classes returning DecompressError rather than unwinding:
  # 1. Unexpected EOF / truncation
  bad_trunc = bomb_comp[0, bomb_comp.size // 2]
  case Inflate.decompress(bad_trunc, 1000_i64)
  when DecompressError
    # ok
  else
    raise "expected DecompressError for truncated stream"
  end

  # 2. Block type 3 (reserved)
  bad_b3 = make_bytes(2) { 7_u8 }
  case Inflate.decompress(bad_b3, 1000_i64)
  when DecompressError
    # ok
  else
    raise "expected DecompressError for block type 3"
  end

  # 3. Stored block LEN/NLEN mismatch
  bad_st = make_bytes(7) { 0_u8 }
  bad_st[0] = 1_u8
  bad_st[1] = 5_u8
  bad_st[3] = 5_u8
  case Inflate.decompress(bad_st, 1000_i64)
  when DecompressError
    # ok
  else
    raise "expected DecompressError for stored LEN/NLEN mismatch"
  end

  # 4. Back-reference distance beyond produced output
  bad_d_val = 1 | (1 << 1) | (1 << 9) | (0b01100 << 10)
  bad_dist_bytes = make_bytes(4) { 0_u8 }
  bad_dist_bytes[0] = (bad_d_val & 0xFF).to_u8
  bad_dist_bytes[1] = ((bad_d_val >> 8) & 0xFF).to_u8
  bad_dist_bytes[2] = ((bad_d_val >> 16) & 0xFF).to_u8
  case Inflate.decompress(bad_dist_bytes, 1000_i64)
  when DecompressError
    # ok
  else
    raise "expected DecompressError for back-reference distance beyond output"
  end

  # 5. Invalid HLIT (> 286)
  b_hlit = make_bytes(4) { 0_u8 }
  b_hlit[0] = 245_u8
  r_hlit = Inflate.decompress(b_hlit, 1000_i64)
  case r_hlit
  when DecompressError
    raise "hlit error mismatch" unless r_hlit.message == "invalid HLIT 287"
  else
    raise "expected DecompressError for invalid HLIT"
  end

  # 6. Invalid literal/length symbol (symbol 286)
  val_sym = 3 | (99 << 3)
  b_sym = make_bytes(3) { 0_u8 }
  b_sym[0] = (val_sym & 0xFF).to_u8
  b_sym[1] = ((val_sym >> 8) & 0xFF).to_u8
  case Inflate.decompress(b_sym, 1000_i64)
  when DecompressError
    # ok
  else
    raise "expected DecompressError for symbol 286"
  end

  # 7. Distance symbol > 29 (symbol 30)
  val_d = 3_i64 | (0b10001110_i64 << 3) | (0b1000000_i64 << 11) | (0b01111_i64 << 18)
  b_dist = make_bytes(4) { 0_u8 }
  b_dist[0] = (val_d & 0xFF_i64).to_u8
  b_dist[1] = ((val_d >> 8) & 0xFF_i64).to_u8
  b_dist[2] = ((val_d >> 16) & 0xFF_i64).to_u8
  b_dist[3] = ((val_d >> 24) & 0xFF_i64).to_u8
  case Inflate.decompress(b_dist, 1000_i64)
  when DecompressError
    # ok
  else
    raise "expected DecompressError for distance symbol 30"
  end

  puts "    bounded decompress: valid blocks, malformed classes, and bomb limit verified"
  puts "all std/compress checks passed"
end

main
