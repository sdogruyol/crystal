import compiler/foundation/location
import compiler/foundation/enums
import compiler/syntax/token
import compiler/syntax/ast
import compiler/syntax/visitor
import compiler/syntax/transformer

using compiler/foundation/location::{Location}
using compiler/syntax/token::{Keyword, TokenKind, NumberKind}
using compiler/syntax/ast::{Alias, AlignOf, And, Annotation, AnnotationDef, Arg, ArrayLiteral, Asm, AsmOperand, Assign, AssocTypeDecl, Block, BoolLiteral, Break, CStructOrUnionDef, Call, Case, Cast, CharLiteral, ClassDef, ClassVar, Def, Defer, DoubleSplat, EnumDef, ExceptionHandler, Expressions, Extend, ExternalVar, FunDef, Generic, Global, HashLiteral, If, ImplDef, ImplicitObj, ImportDecl, Include, InstanceAlignOf, InstanceSizeOf, InstanceVar, IsA, LibDef, Macro, MacroExpression, MacroFor, MacroIf, MacroLiteral, MacroVar, MacroVerbatim, MagicConstant, Metaclass, ModuleDef, ModuleHeader, MultiAssign, NamedArgument, NamedTupleLiteral, Next, NilLiteral, NilableCast, Nop, Not, NumberLiteral, OffsetOf, OpAssign, Or, Out, Path, PointerOf, ProcLiteral, ProcNotation, ProcPointer, Propagate, RangeLiteral, ReadInstanceVar, Recover, RegexLiteral, Require, Rescue, RespondsTo, Return, Select, Self, SizeOf, Splat, StringInterpolation, StringLiteral, SymbolLiteral, TraitDef, TupleLiteral, TypeDeclaration, TypeDef, TypeOf, Underscore, UninitializedVar, Unless, Until, UsingDecl, Var, VisibilityModifier, When, While, Yield, ASTNode, BinaryOp, UnaryExpression, ControlExpression, NodeMap, StringBuilder, Visibility, RegexOptions}
using compiler/syntax/visitor::{Visitor, ToSVisitor, NodeCounterVisitor}
using compiler/syntax/transformer::{Transformer}

alias ASTUnion = Compiler::Syntax::Ast::Union

module BenchSelfhostAstExercise
  class ConstantFolder < Transformer
    def transform(node : NumberLiteral) : ASTNode
      val = node.value.to_i
      NumberLiteral.new((val * 2).to_s, node.kind)
    end

    def transform(node : Var) : ASTNode
      Var.new(node.name + "_renamed")
    end
  end

  def self.assert(cond : Bool, msg : String)
    unless cond
      puts "Assertion failed: " + msg
      raise "Assertion failed: " + msg
    end
  end

  def self.test_node_construction
    puts "testing construction of all 104 concrete AST node kinds..."
    nodes = [] of ASTNode
    n_Alias = Alias.new(Path.new("MyInt"), Path.new("Int32"))
    assert(n_Alias.is_a?(Alias), "construction of Alias")
    nodes << n_Alias
    n_AlignOf = AlignOf.new(Path.new("Int64"))
    assert(n_AlignOf.is_a?(AlignOf), "construction of AlignOf")
    nodes << n_AlignOf
    n_And = And.new(BoolLiteral.new(true), BoolLiteral.new(false))
    assert(n_And.is_a?(And), "construction of And")
    nodes << n_And
    n_Annotation = Annotation.new(Path.new("AlwaysInline"))
    assert(n_Annotation.is_a?(Annotation), "construction of Annotation")
    nodes << n_Annotation
    n_AnnotationDef = AnnotationDef.new(Path.new("MyAnno"))
    assert(n_AnnotationDef.is_a?(AnnotationDef), "construction of AnnotationDef")
    nodes << n_AnnotationDef
    n_Arg = Arg.new("x", NumberLiteral.new("0"), Path.new("Int32"))
    assert(n_Arg.is_a?(Arg), "construction of Arg")
    nodes << n_Arg
    n_ArrayLiteral = ArrayLiteral.new(([NumberLiteral.new("1"), NumberLiteral.new("2")] of ASTNode))
    assert(n_ArrayLiteral.is_a?(ArrayLiteral), "construction of ArrayLiteral")
    nodes << n_ArrayLiteral
    n_Asm = Asm.new("nop", [AsmOperand.new("=r", Var.new("o"))], [AsmOperand.new("r", Var.new("i"))], ["memory"])
    assert(n_Asm.is_a?(Asm), "construction of Asm")
    nodes << n_Asm
    n_AsmOperand = AsmOperand.new("=r", Var.new("out_val"))
    assert(n_AsmOperand.is_a?(AsmOperand), "construction of AsmOperand")
    nodes << n_AsmOperand
    n_Assign = Assign.new(Var.new("x"), NumberLiteral.new("100"))
    assert(n_Assign.is_a?(Assign), "construction of Assign")
    nodes << n_Assign
    n_AssocTypeDecl = AssocTypeDecl.new("Item", Path.new("String"))
    assert(n_AssocTypeDecl.is_a?(AssocTypeDecl), "construction of AssocTypeDecl")
    nodes << n_AssocTypeDecl
    n_Block = Block.new([Var.new("item")], NumberLiteral.new("1"))
    assert(n_Block.is_a?(Block), "construction of Block")
    nodes << n_Block
    n_BoolLiteral = BoolLiteral.new(true)
    assert(n_BoolLiteral.is_a?(BoolLiteral), "construction of BoolLiteral")
    nodes << n_BoolLiteral
    n_Break = Break.new(NumberLiteral.new("0"))
    assert(n_Break.is_a?(Break), "construction of Break")
    nodes << n_Break
    n_CStructOrUnionDef = CStructOrUnionDef.new("Point", NumberLiteral.new("0"), false)
    assert(n_CStructOrUnionDef.is_a?(CStructOrUnionDef), "construction of CStructOrUnionDef")
    nodes << n_CStructOrUnionDef
    n_Call = Call.new(Var.new("math"), "add", ([NumberLiteral.new("1"), NumberLiteral.new("2")] of ASTNode))
    assert(n_Call.is_a?(Call), "construction of Call")
    nodes << n_Call
    n_Case = Case.new(Var.new("x"), [When.new(([NumberLiteral.new("1")] of ASTNode), StringLiteral.new("one"))])
    assert(n_Case.is_a?(Case), "construction of Case")
    nodes << n_Case
    n_Cast = Cast.new(Var.new("x"), Path.new("String"))
    assert(n_Cast.is_a?(Cast), "construction of Cast")
    nodes << n_Cast
    n_CharLiteral = CharLiteral.new('z')
