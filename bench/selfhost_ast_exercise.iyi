  def self.test_visitor_traversal
    puts "testing Visitor and ToSVisitor traversal..."
    counter = NodeCounterVisitor.new
    tree = Expressions.new(([
      Assign.new(Var.new("x"), NumberLiteral.new("10")),
      If.new(BoolLiteral.new(true), Return.new(Var.new("x")), Nop.new),
      Call.new(nil, "print", ([StringLiteral.new("done")] of ASTNode)),
    ] of ASTNode))
    tree.accept(counter)
    assert(counter.count == 11, "NodeCounterVisitor counted all nodes in tree")

    tos_visitor = ToSVisitor.new
    tree.accept(tos_visitor)
    formatted = tos_visitor.to_s
    assert(formatted.includes?("x = 10"), "ToSVisitor formatted Assign")
    assert(formatted.includes?("if true"), "ToSVisitor formatted If")
    assert(formatted.includes?("print("), "ToSVisitor formatted Call")
    puts "ok (visitor traversal and ToSVisitor formatting verified)"
  end

  def self.test_transformer
    puts "testing Transformer framework..."
    folder = ConstantFolder.new
    orig = Assign.new(Var.new("counter"), NumberLiteral.new("5"))
    transformed = orig.transform(folder).as(Assign)
    assert(transformed.target.as(Var).name == "counter_renamed", "transformer renamed target")
    assert(transformed.value.as(NumberLiteral).value == "10", "transformer folded value")
    puts "ok (transformer tree modification verified)"
  end

  def self.test_node_map
    puts "testing out-of-band NodeMap side storage (no reopening of node types)..."
    type_map = NodeMap(String).new
    n1 = NumberLiteral.new("42")
    n2 = StringLiteral.new("hello")
    n3 = BoolLiteral.new(true)

    type_map[n1] = "Int32"
    type_map[n2] = "String"
    type_map[n3] = "Bool"

    assert(type_map.size == 3, "NodeMap contains 3 entries")
    assert(type_map[n1] == "Int32", "NodeMap lookup n1")
    assert(type_map[n2] == "String", "NodeMap lookup n2")
    assert(type_map[n3] == "Bool", "NodeMap lookup n3")
    assert(type_map.has_key?(n1), "NodeMap has_key? n1")
    assert(!type_map.has_key?(Var.new("other")), "NodeMap does not have unmapped node")

    deleted = type_map.delete(n2)
    assert(deleted == "String", "NodeMap delete returned deleted value")
    assert(type_map.size == 2, "NodeMap size decreased after delete")
    assert(type_map[n2]? == nil, "deleted key returns nil")

    type_map.clear
    assert(type_map.empty?, "NodeMap clear emptied store")
    assert(type_map.size == 0, "NodeMap size 0 after clear")
    puts "ok (NodeMap out-of-band side storage verified)"
  end

  def self.run_all
    puts "=== Running Selfhost AST Exercise Suite ==="
    test_node_construction
    test_node_cloning
    test_node_equality
    test_node_to_s
    test_visitor_traversal
    test_transformer
    test_node_map
    puts "ALL SELFHOST AST CHECKS PASSED SUCCESSFULLY!"
  end
end

BenchSelfhostAstExercise.run_all
