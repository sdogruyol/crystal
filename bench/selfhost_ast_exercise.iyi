  def self.test_node_to_s
    puts "testing to_s string formatting for all 104 concrete AST node kinds..."
    node_Alias = Alias.new(Path.new("MyInt"), Path.new("Int32"))
    str_Alias = node_Alias.to_s
    assert(!str_Alias.empty?, "to_s non-empty for Alias")
    node_AlignOf = AlignOf.new(Path.new("Int64"))
    str_AlignOf = node_AlignOf.to_s
    assert(!str_AlignOf.empty?, "to_s non-empty for AlignOf")
    node_And = And.new(BoolLiteral.new(true), BoolLiteral.new(false))
    str_And = node_And.to_s
    assert(!str_And.empty?, "to_s non-empty for And")
    node_Annotation = Annotation.new(Path.new("AlwaysInline"))
    str_Annotation = node_Annotation.to_s
    assert(!str_Annotation.empty?, "to_s non-empty for Annotation")
    node_AnnotationDef = AnnotationDef.new(Path.new("MyAnno"))
    str_AnnotationDef = node_AnnotationDef.to_s
    assert(!str_AnnotationDef.empty?, "to_s non-empty for AnnotationDef")
    node_Arg = Arg.new("x", NumberLiteral.new("0"), Path.new("Int32"))
    str_Arg = node_Arg.to_s
    assert(!str_Arg.empty?, "to_s non-empty for Arg")
    node_ArrayLiteral = ArrayLiteral.new(([NumberLiteral.new("1"), NumberLiteral.new("2")] of ASTNode))
    str_ArrayLiteral = node_ArrayLiteral.to_s
    assert(!str_ArrayLiteral.empty?, "to_s non-empty for ArrayLiteral")
    node_Asm = Asm.new("nop", [AsmOperand.new("=r", Var.new("o"))], [AsmOperand.new("r", Var.new("i"))], ["memory"])
    str_Asm = node_Asm.to_s
    assert(!str_Asm.empty?, "to_s non-empty for Asm")
    node_AsmOperand = AsmOperand.new("=r", Var.new("out_val"))
    str_AsmOperand = node_AsmOperand.to_s
    assert(!str_AsmOperand.empty?, "to_s non-empty for AsmOperand")
    node_Assign = Assign.new(Var.new("x"), NumberLiteral.new("100"))
    str_Assign = node_Assign.to_s
    assert(!str_Assign.empty?, "to_s non-empty for Assign")
    node_AssocTypeDecl = AssocTypeDecl.new("Item", Path.new("String"))
    str_AssocTypeDecl = node_AssocTypeDecl.to_s
    assert(!str_AssocTypeDecl.empty?, "to_s non-empty for AssocTypeDecl")
    node_Block = Block.new([Var.new("item")], NumberLiteral.new("1"))
    str_Block = node_Block.to_s
    assert(!str_Block.empty?, "to_s non-empty for Block")
    node_BoolLiteral = BoolLiteral.new(true)
    str_BoolLiteral = node_BoolLiteral.to_s
    assert(!str_BoolLiteral.empty?, "to_s non-empty for BoolLiteral")
    node_Break = Break.new(NumberLiteral.new("0"))
    str_Break = node_Break.to_s
    assert(!str_Break.empty?, "to_s non-empty for Break")
    node_CStructOrUnionDef = CStructOrUnionDef.new("Point", NumberLiteral.new("0"), false)
    str_CStructOrUnionDef = node_CStructOrUnionDef.to_s
    assert(!str_CStructOrUnionDef.empty?, "to_s non-empty for CStructOrUnionDef")
    node_Call = Call.new(Var.new("math"), "add", ([NumberLiteral.new("1"), NumberLiteral.new("2")] of ASTNode))
    str_Call = node_Call.to_s
    assert(!str_Call.empty?, "to_s non-empty for Call")
    node_Case = Case.new(Var.new("x"), [When.new(([NumberLiteral.new("1")] of ASTNode), StringLiteral.new("one"))])
    str_Case = node_Case.to_s
    assert(!str_Case.empty?, "to_s non-empty for Case")
    node_Cast = Cast.new(Var.new("x"), Path.new("String"))
    str_Cast = node_Cast.to_s
    assert(!str_Cast.empty?, "to_s non-empty for Cast")
    node_CharLiteral = CharLiteral.new('z')
    str_CharLiteral = node_CharLiteral.to_s
    assert(!str_CharLiteral.empty?, "to_s non-empty for CharLiteral")
    node_ClassDef = ClassDef.new(Path.new("MyClass"), NumberLiteral.new("1"), Path.new("Object"))
    str_ClassDef = node_ClassDef.to_s
    assert(!str_ClassDef.empty?, "to_s non-empty for ClassDef")
    node_ClassVar = ClassVar.new("@@my_cvar")
    str_ClassVar = node_ClassVar.to_s
    assert(!str_ClassVar.empty?, "to_s non-empty for ClassVar")
    node_Def = Def.new("my_func", [Arg.new("a")], NumberLiteral.new("99"))
    str_Def = node_Def.to_s
    assert(!str_Def.empty?, "to_s non-empty for Def")
    node_Defer = Defer.new(Call.new(nil, "cleanup"))
    str_Defer = node_Defer.to_s
    assert(!str_Defer.empty?, "to_s non-empty for Defer")
    node_DoubleSplat = DoubleSplat.new(Var.new("kwargs"))
    str_DoubleSplat = node_DoubleSplat.to_s
    assert(!str_DoubleSplat.empty?, "to_s non-empty for DoubleSplat")
    node_EnumDef = EnumDef.new(Path.new("Color"), ([Var.new("Red"), Var.new("Green")] of ASTNode))
    str_EnumDef = node_EnumDef.to_s
    assert(!str_EnumDef.empty?, "to_s non-empty for EnumDef")
    node_ExceptionHandler = ExceptionHandler.new(NumberLiteral.new("1"), [Rescue.new(NumberLiteral.new("2"))])
    str_ExceptionHandler = node_ExceptionHandler.to_s
    assert(!str_ExceptionHandler.empty?, "to_s non-empty for ExceptionHandler")
    node_Expressions = Expressions.new(([Var.new("a"), Var.new("b")] of ASTNode), Expressions::Keyword::None)
    str_Expressions = node_Expressions.to_s
    assert(!str_Expressions.empty?, "to_s non-empty for Expressions")
    node_Extend = Extend.new(Path.new("ClassMethods"))
    str_Extend = node_Extend.to_s
    assert(!str_Extend.empty?, "to_s non-empty for Extend")
    node_ExternalVar = ExternalVar.new("errno", Path.new("Int32"))
    str_ExternalVar = node_ExternalVar.to_s
    assert(!str_ExternalVar.empty?, "to_s non-empty for ExternalVar")
    node_FunDef = FunDef.new("puts", [Arg.new("s", nil, Path.new("String"))], Path.new("Int32"))
    str_FunDef = node_FunDef.to_s
    assert(!str_FunDef.empty?, "to_s non-empty for FunDef")
    node_Generic = Generic.new(Path.new("Array"), ([Path.new("Int32")] of ASTNode))
    str_Generic = node_Generic.to_s
    assert(!str_Generic.empty?, "to_s non-empty for Generic")
