  def self.test_node_cloning
    puts "testing cloning for all 104 concrete AST node kinds..."
    loc = Location.new("file.iyi", 10, 5)
    end_loc = Location.new("file.iyi", 10, 25)
    orig_Alias = Alias.new(Path.new("MyInt"), Path.new("Int32"))
    orig_Alias.at(loc).at_end(end_loc)
    orig_Alias.doc = "documentation for Alias"
    orig_Alias.visibility = Visibility::Private
    clone_Alias = orig_Alias.clone
    assert(clone_Alias.is_a?(Alias), "clone type of Alias")
    assert(clone_Alias.location == loc, "clone location of Alias")
    assert(clone_Alias.end_location == end_loc, "clone end_location of Alias")
    assert(clone_Alias.doc == "documentation for Alias", "clone doc of Alias")
    assert(clone_Alias.visibility == Visibility::Private, "clone visibility of Alias")
    assert(clone_Alias.node_id != orig_Alias.node_id, "clone creates distinct instance for Alias")
    orig_AlignOf = AlignOf.new(Path.new("Int64"))
    orig_AlignOf.at(loc).at_end(end_loc)
    orig_AlignOf.doc = "documentation for AlignOf"
    orig_AlignOf.visibility = Visibility::Private
    clone_AlignOf = orig_AlignOf.clone
    assert(clone_AlignOf.is_a?(AlignOf), "clone type of AlignOf")
    assert(clone_AlignOf.location == loc, "clone location of AlignOf")
    assert(clone_AlignOf.end_location == end_loc, "clone end_location of AlignOf")
    assert(clone_AlignOf.doc == "documentation for AlignOf", "clone doc of AlignOf")
    assert(clone_AlignOf.visibility == Visibility::Private, "clone visibility of AlignOf")
    assert(clone_AlignOf.node_id != orig_AlignOf.node_id, "clone creates distinct instance for AlignOf")
    orig_And = And.new(BoolLiteral.new(true), BoolLiteral.new(false))
    orig_And.at(loc).at_end(end_loc)
    orig_And.doc = "documentation for And"
    orig_And.visibility = Visibility::Private
    clone_And = orig_And.clone
    assert(clone_And.is_a?(And), "clone type of And")
    assert(clone_And.location == loc, "clone location of And")
    assert(clone_And.end_location == end_loc, "clone end_location of And")
    assert(clone_And.doc == "documentation for And", "clone doc of And")
    assert(clone_And.visibility == Visibility::Private, "clone visibility of And")
    assert(clone_And.node_id != orig_And.node_id, "clone creates distinct instance for And")
    orig_Annotation = Annotation.new(Path.new("AlwaysInline"))
    orig_Annotation.at(loc).at_end(end_loc)
    orig_Annotation.doc = "documentation for Annotation"
    orig_Annotation.visibility = Visibility::Private
    clone_Annotation = orig_Annotation.clone
    assert(clone_Annotation.is_a?(Annotation), "clone type of Annotation")
    assert(clone_Annotation.location == loc, "clone location of Annotation")
    assert(clone_Annotation.end_location == end_loc, "clone end_location of Annotation")
    assert(clone_Annotation.doc == "documentation for Annotation", "clone doc of Annotation")
    assert(clone_Annotation.visibility == Visibility::Private, "clone visibility of Annotation")
    assert(clone_Annotation.node_id != orig_Annotation.node_id, "clone creates distinct instance for Annotation")
    orig_AnnotationDef = AnnotationDef.new(Path.new("MyAnno"))
    orig_AnnotationDef.at(loc).at_end(end_loc)
    orig_AnnotationDef.doc = "documentation for AnnotationDef"
    orig_AnnotationDef.visibility = Visibility::Private
    clone_AnnotationDef = orig_AnnotationDef.clone
    assert(clone_AnnotationDef.is_a?(AnnotationDef), "clone type of AnnotationDef")
    assert(clone_AnnotationDef.location == loc, "clone location of AnnotationDef")
    assert(clone_AnnotationDef.end_location == end_loc, "clone end_location of AnnotationDef")
    assert(clone_AnnotationDef.doc == "documentation for AnnotationDef", "clone doc of AnnotationDef")
    assert(clone_AnnotationDef.visibility == Visibility::Private, "clone visibility of AnnotationDef")
    assert(clone_AnnotationDef.node_id != orig_AnnotationDef.node_id, "clone creates distinct instance for AnnotationDef")
    orig_Arg = Arg.new("x", NumberLiteral.new("0"), Path.new("Int32"))
    orig_Arg.at(loc).at_end(end_loc)
    orig_Arg.doc = "documentation for Arg"
