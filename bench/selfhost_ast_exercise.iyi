  def self.test_node_equality
    puts "testing equality and hashing for all 104 concrete AST node kinds..."
    a_Alias = Alias.new(Path.new("MyInt"), Path.new("Int32"))
    b_Alias = Alias.new(Path.new("MyInt"), Path.new("Int32"))
    assert(a_Alias == b_Alias, "equality of identical Alias")
    assert(a_Alias.hash == b_Alias.hash, "hash consistency of Alias")
    assert(!(a_Alias == Nop.new) || "Alias" == "Nop", "inequality across different types for Alias")
    a_AlignOf = AlignOf.new(Path.new("Int64"))
