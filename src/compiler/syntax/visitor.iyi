pub class ToSVisitor < Visitor
  getter sb : StringBuilder

  def initialize(@sb : StringBuilder = StringBuilder.new)
  end

  def to_s : String
    @sb.to_s
  end

  def visit(node : Alias) : Bool
    node.to_s(@sb)
    false
  end

