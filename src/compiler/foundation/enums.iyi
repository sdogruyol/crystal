module compiler/foundation/enums

struct ::Enum
  def ==(other : self) : Bool
    value == other.value
  end

  def ===(other : self) : Bool
    value == other.value
  end

  def !=(other : self) : Bool
    value != other.value
  end

  def <(other : self) : Bool
    value < other.value
  end

  def <=(other : self) : Bool
    value <= other.value
  end

  def >(other : self) : Bool
    value > other.value
  end

  def >=(other : self) : Bool
    value >= other.value
  end
end

struct ::Range(B, E)
  def ===(value) : Bool
    if exclusive?
      value >= self.begin && value < self.end
    else
      value >= self.begin && value <= self.end
    end
  end
end
