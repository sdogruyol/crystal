# Native cryptographic hash functions: MD5, SHA-1, SHA-256, SHA-384, SHA-512.
#
# Notice: this implementation has not undergone independent cryptographic review.
#
# Provides one-shot digest/hexdigest and incremental streaming (new/update/final).
# Pure iyi implementation without OpenSSL or libcrypto dependencies.

module std/digest

import std/slice
using std/slice::{Slice}
pub alias Bytes = Std::Slice::Bytes

module DigestUtils
  def self.get_u32_le(ptr : Pointer(UInt8), offset : Int32) : UInt64
    ptr[offset].to_u64 |
      (ptr[offset + 1].to_u64.unsafe_shl(8_u64)) |
      (ptr[offset + 2].to_u64.unsafe_shl(16_u64)) |
      (ptr[offset + 3].to_u64.unsafe_shl(24_u64))
  end

  def self.put_u32_le(ptr : Pointer(UInt8), offset : Int32, v : UInt64) : Nil
    ptr[offset] = (v & 0xff_u64).to_u8
    ptr[offset + 1] = ((v.unsafe_shr(8_u64)) & 0xff_u64).to_u8
    ptr[offset + 2] = ((v.unsafe_shr(16_u64)) & 0xff_u64).to_u8
    ptr[offset + 3] = ((v.unsafe_shr(24_u64)) & 0xff_u64).to_u8
  end

  def self.get_u32_be(ptr : Pointer(UInt8), offset : Int32) : UInt64
    (ptr[offset].to_u64.unsafe_shl(24_u64)) |
      (ptr[offset + 1].to_u64.unsafe_shl(16_u64)) |
      (ptr[offset + 2].to_u64.unsafe_shl(8_u64)) |
      ptr[offset + 3].to_u64
  end

  def self.put_u32_be(ptr : Pointer(UInt8), offset : Int32, v : UInt64) : Nil
    ptr[offset] = ((v.unsafe_shr(24_u64)) & 0xff_u64).to_u8
    ptr[offset + 1] = ((v.unsafe_shr(16_u64)) & 0xff_u64).to_u8
    ptr[offset + 2] = ((v.unsafe_shr(8_u64)) & 0xff_u64).to_u8
    ptr[offset + 3] = (v & 0xff_u64).to_u8
  end

  def self.get_u64_be(ptr : Pointer(UInt8), offset : Int32) : UInt64
    (ptr[offset].to_u64.unsafe_shl(56_u64)) |
      (ptr[offset + 1].to_u64.unsafe_shl(48_u64)) |
      (ptr[offset + 2].to_u64.unsafe_shl(40_u64)) |
      (ptr[offset + 3].to_u64.unsafe_shl(32_u64)) |
      (ptr[offset + 4].to_u64.unsafe_shl(24_u64)) |
      (ptr[offset + 5].to_u64.unsafe_shl(16_u64)) |
      (ptr[offset + 6].to_u64.unsafe_shl(8_u64)) |
      ptr[offset + 7].to_u64
  end

  def self.put_u64_be(ptr : Pointer(UInt8), offset : Int32, v : UInt64) : Nil
    ptr[offset] = ((v.unsafe_shr(56_u64)) & 0xff_u64).to_u8
    ptr[offset + 1] = ((v.unsafe_shr(48_u64)) & 0xff_u64).to_u8
    ptr[offset + 2] = ((v.unsafe_shr(40_u64)) & 0xff_u64).to_u8
    ptr[offset + 3] = ((v.unsafe_shr(32_u64)) & 0xff_u64).to_u8
    ptr[offset + 4] = ((v.unsafe_shr(24_u64)) & 0xff_u64).to_u8
    ptr[offset + 5] = ((v.unsafe_shr(16_u64)) & 0xff_u64).to_u8
    ptr[offset + 6] = ((v.unsafe_shr(8_u64)) & 0xff_u64).to_u8
    ptr[offset + 7] = (v & 0xff_u64).to_u8
  end

  def self.rotl32(x : UInt64, n : Int32) : UInt64
    ((x.unsafe_shl(n.to_u64)) | (x.unsafe_shr((32 - n).to_u64))) & 0xffffffff_u64
  end

  def self.rotr32(x : UInt64, n : Int32) : UInt64
    ((x.unsafe_shr(n.to_u64)) | (x.unsafe_shl((32 - n).to_u64))) & 0xffffffff_u64
  end

  def self.rotl64(x : UInt64, n : Int32) : UInt64
    (x.unsafe_shl(n.to_u64)) | (x.unsafe_shr((64 - n).to_u64))
  end

  def self.rotr64(x : UInt64, n : Int32) : UInt64
    (x.unsafe_shr(n.to_u64)) | (x.unsafe_shl((64 - n).to_u64))
  end
end

pub class MD5
  @a : UInt64 = 0x67452301_u64
  @b : UInt64 = 0xefcdab89_u64
  @c : UInt64 = 0x98badcfe_u64
  @d : UInt64 = 0x10325476_u64
  @buffer : Pointer(UInt8)
  @buffer_len : Int32 = 0
  @total_bytes : UInt64 = 0_u64
  @finished : Bool = false

  def initialize
    @buffer = Pointer(UInt8).malloc(64_u64)
    reset
  end

  def reset : self
    @a = 0x67452301_u64
    @b = 0xefcdab89_u64
    @c = 0x98badcfe_u64
    @d = 0x10325476_u64
    @buffer_len = 0
    @total_bytes = 0_u64
    @finished = false
    self
  end

  def update(data : Bytes) : self
    raise "MD5: already finalized" if @finished
    offset = 0
    len = data.size
    @total_bytes = @total_bytes &+ len.to_u64
    if @buffer_len > 0
      needed = 64 - @buffer_len
      to_copy = len < needed ? len : needed
      i = 0
      while i < to_copy
        @buffer[@buffer_len + i] = data[offset + i]
        i = i + 1
      end
      @buffer_len = @buffer_len + to_copy
      offset = offset + to_copy
      len = len - to_copy
      if @buffer_len == 64
        process_block(@buffer)
        @buffer_len = 0
      end
    end
    while len >= 64
      process_block(data.to_unsafe + offset.to_i64)
      offset = offset + 64
      len = len - 64
    end
    if len > 0
      i = 0
      while i < len
        @buffer[i] = data[offset + i]
        i = i + 1
      end
      @buffer_len = len
    end
    self
  end

  def update(data : String) : self
    update(Bytes.new(data.to_unsafe, data.bytesize))
  end

  private def process_block(ptr : Pointer(UInt8)) : Nil
    m0 = DigestUtils.get_u32_le(ptr, 0)
    m1 = DigestUtils.get_u32_le(ptr, 4)
    m2 = DigestUtils.get_u32_le(ptr, 8)
    m3 = DigestUtils.get_u32_le(ptr, 12)
    m4 = DigestUtils.get_u32_le(ptr, 16)
    m5 = DigestUtils.get_u32_le(ptr, 20)
    m6 = DigestUtils.get_u32_le(ptr, 24)
    m7 = DigestUtils.get_u32_le(ptr, 28)
    m8 = DigestUtils.get_u32_le(ptr, 32)
    m9 = DigestUtils.get_u32_le(ptr, 36)
    m10 = DigestUtils.get_u32_le(ptr, 40)
    m11 = DigestUtils.get_u32_le(ptr, 44)
    m12 = DigestUtils.get_u32_le(ptr, 48)
    m13 = DigestUtils.get_u32_le(ptr, 52)
    m14 = DigestUtils.get_u32_le(ptr, 56)
    m15 = DigestUtils.get_u32_le(ptr, 60)
    a = @a; b = @b; c = @c; d = @d
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m0 &+ 0xd76aa478_u64) & 0xffffffff_u64, 7)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m1 &+ 0xe8c7b756_u64) & 0xffffffff_u64, 12)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m2 &+ 0x242070db_u64) & 0xffffffff_u64, 17)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m3 &+ 0xc1bdceee_u64) & 0xffffffff_u64, 22)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m4 &+ 0xf57c0faf_u64) & 0xffffffff_u64, 7)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m5 &+ 0x4787c62a_u64) & 0xffffffff_u64, 12)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m6 &+ 0xa8304613_u64) & 0xffffffff_u64, 17)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m7 &+ 0xfd469501_u64) & 0xffffffff_u64, 22)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m8 &+ 0x698098d8_u64) & 0xffffffff_u64, 7)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m9 &+ 0x8b44f7af_u64) & 0xffffffff_u64, 12)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m10 &+ 0xffff5bb1_u64) & 0xffffffff_u64, 17)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m11 &+ 0x895cd7be_u64) & 0xffffffff_u64, 22)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m12 &+ 0x6b901122_u64) & 0xffffffff_u64, 7)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m13 &+ 0xfd987193_u64) & 0xffffffff_u64, 12)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m14 &+ 0xa679438e_u64) & 0xffffffff_u64, 17)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & c) | ((b ^ 0xffffffff_u64) & d)) &+ m15 &+ 0x49b40821_u64) & 0xffffffff_u64, 22)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m1 &+ 0xf61e2562_u64) & 0xffffffff_u64, 5)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m6 &+ 0xc040b340_u64) & 0xffffffff_u64, 9)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m11 &+ 0x265e5a51_u64) & 0xffffffff_u64, 14)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m0 &+ 0xe9b6c7aa_u64) & 0xffffffff_u64, 20)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m5 &+ 0xd62f105d_u64) & 0xffffffff_u64, 5)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m10 &+ 0x02441453_u64) & 0xffffffff_u64, 9)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m15 &+ 0xd8a1e681_u64) & 0xffffffff_u64, 14)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m4 &+ 0xe7d3fbc8_u64) & 0xffffffff_u64, 20)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m9 &+ 0x21e1cde6_u64) & 0xffffffff_u64, 5)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m14 &+ 0xc33707d6_u64) & 0xffffffff_u64, 9)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m3 &+ 0xf4d50d87_u64) & 0xffffffff_u64, 14)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m8 &+ 0x455a14ed_u64) & 0xffffffff_u64, 20)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m13 &+ 0xa9e3e905_u64) & 0xffffffff_u64, 5)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m2 &+ 0xfcefa3f8_u64) & 0xffffffff_u64, 9)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m7 &+ 0x676f02d9_u64) & 0xffffffff_u64, 14)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ ((b & d) | (c & (d ^ 0xffffffff_u64))) &+ m12 &+ 0x8d2a4c8a_u64) & 0xffffffff_u64, 20)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m5 &+ 0xfffa3942_u64) & 0xffffffff_u64, 4)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m8 &+ 0x8771f681_u64) & 0xffffffff_u64, 11)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m11 &+ 0x6d9d6122_u64) & 0xffffffff_u64, 16)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m14 &+ 0xfde5380c_u64) & 0xffffffff_u64, 23)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m1 &+ 0xa4beea44_u64) & 0xffffffff_u64, 4)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m4 &+ 0x4bdecfa9_u64) & 0xffffffff_u64, 11)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m7 &+ 0xf6bb4b60_u64) & 0xffffffff_u64, 16)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m10 &+ 0xbebfbc70_u64) & 0xffffffff_u64, 23)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m13 &+ 0x289b7ec6_u64) & 0xffffffff_u64, 4)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m0 &+ 0xeaa127fa_u64) & 0xffffffff_u64, 11)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m3 &+ 0xd4ef3085_u64) & 0xffffffff_u64, 16)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m6 &+ 0x04881d05_u64) & 0xffffffff_u64, 23)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m9 &+ 0xd9d4d039_u64) & 0xffffffff_u64, 4)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m12 &+ 0xe6db99e5_u64) & 0xffffffff_u64, 11)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m15 &+ 0x1fa27cf8_u64) & 0xffffffff_u64, 16)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (b ^ c ^ d) &+ m2 &+ 0xc4ac5665_u64) & 0xffffffff_u64, 23)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m0 &+ 0xf4292244_u64) & 0xffffffff_u64, 6)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m7 &+ 0x432aff97_u64) & 0xffffffff_u64, 10)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m14 &+ 0xab9423a7_u64) & 0xffffffff_u64, 15)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m5 &+ 0xfc93a039_u64) & 0xffffffff_u64, 21)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m12 &+ 0x655b59c3_u64) & 0xffffffff_u64, 6)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m3 &+ 0x8f0ccc92_u64) & 0xffffffff_u64, 10)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m10 &+ 0xffeff47d_u64) & 0xffffffff_u64, 15)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m1 &+ 0x85845dd1_u64) & 0xffffffff_u64, 21)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m8 &+ 0x6fa87e4f_u64) & 0xffffffff_u64, 6)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m15 &+ 0xfe2ce6e0_u64) & 0xffffffff_u64, 10)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m6 &+ 0xa3014314_u64) & 0xffffffff_u64, 15)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m13 &+ 0x4e0811a1_u64) & 0xffffffff_u64, 21)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m4 &+ 0xf7537e82_u64) & 0xffffffff_u64, 6)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m11 &+ 0xbd3af235_u64) & 0xffffffff_u64, 10)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m2 &+ 0x2ad7d2bb_u64) & 0xffffffff_u64, 15)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    t = (b &+ DigestUtils.rotl32((a &+ (c ^ (b | (d ^ 0xffffffff_u64))) &+ m9 &+ 0xeb86d391_u64) & 0xffffffff_u64, 21)) & 0xffffffff_u64
    a = d; d = c; c = b; b = t
    @a = (@a &+ a) & 0xffffffff_u64
    @b = (@b &+ b) & 0xffffffff_u64
    @c = (@c &+ c) & 0xffffffff_u64
    @d = (@d &+ d) & 0xffffffff_u64
  end

  def final : Bytes
    return out_digest if @finished
    @finished = true
    bit_len = @total_bytes.unsafe_shl(3_u64)
    @buffer[@buffer_len] = 0x80_u8
    @buffer_len = @buffer_len + 1
    if @buffer_len > 56
      while @buffer_len < 64
        @buffer[@buffer_len] = 0_u8
        @buffer_len = @buffer_len + 1
      end
      process_block(@buffer)
      @buffer_len = 0
    end
    while @buffer_len < 56
      @buffer[@buffer_len] = 0_u8
      @buffer_len = @buffer_len + 1
    end
    DigestUtils.put_u32_le(@buffer, 56, bit_len & 0xffffffff_u64)
    DigestUtils.put_u32_le(@buffer, 60, bit_len.unsafe_shr(32_u64))
    process_block(@buffer)
    out_digest
  end

  private def out_digest : Bytes
    out = Bytes.new(16)
    ptr = out.to_unsafe
    DigestUtils.put_u32_le(ptr, 0, @a)
    DigestUtils.put_u32_le(ptr, 4, @b)
    DigestUtils.put_u32_le(ptr, 8, @c)
    DigestUtils.put_u32_le(ptr, 12, @d)
    out
  end

  def hexdigest : String
    final.hexstring
  end

  def self.digest(data : Bytes) : Bytes
    new.update(data).final
  end

  def self.digest(data : String) : Bytes
    new.update(data).final
  end

  def self.hexdigest(data : Bytes) : String
    new.update(data).hexdigest
  end

  def self.hexdigest(data : String) : String
    new.update(data).hexdigest
  end

  def self.digest_size : Int32
    16
  end

  def self.block_size : Int32
    64
  end

  def digest_size : Int32
    16
  end

  def block_size : Int32
    64
  end

  def finished? : Bool
    @finished
  end
end

pub class SHA1
  @h0 : UInt64 = 0x67452301_u64
  @h1 : UInt64 = 0xefcdab89_u64
  @h2 : UInt64 = 0x98badcfe_u64
  @h3 : UInt64 = 0x10325476_u64
  @h4 : UInt64 = 0xc3d2e1f0_u64
  @buffer : Pointer(UInt8)
  @buffer_len : Int32 = 0
  @total_bytes : UInt64 = 0_u64
  @w : Pointer(UInt64)
  @finished : Bool = false

  def initialize
    @buffer = Pointer(UInt8).malloc(64_u64)
    @w = Pointer(UInt64).malloc(80_u64)
    reset
  end

  def reset : self
    @h0 = 0x67452301_u64
    @h1 = 0xefcdab89_u64
    @h2 = 0x98badcfe_u64
    @h3 = 0x10325476_u64
    @h4 = 0xc3d2e1f0_u64
    @buffer_len = 0
    @total_bytes = 0_u64
    @finished = false
    self
  end

  def update(data : Bytes) : self
    raise "SHA1: already finalized" if @finished
    offset = 0
    len = data.size
    @total_bytes = @total_bytes &+ len.to_u64
    if @buffer_len > 0
      needed = 64 - @buffer_len
      to_copy = len < needed ? len : needed
      i = 0
      while i < to_copy
        @buffer[@buffer_len + i] = data[offset + i]
        i = i + 1
      end
      @buffer_len = @buffer_len + to_copy
      offset = offset + to_copy
      len = len - to_copy
      if @buffer_len == 64
        process_block(@buffer)
        @buffer_len = 0
      end
    end
    while len >= 64
      process_block(data.to_unsafe + offset.to_i64)
      offset = offset + 64
      len = len - 64
    end
    if len > 0
      i = 0
      while i < len
        @buffer[i] = data[offset + i]
        i = i + 1
      end
      @buffer_len = len
    end
    self
  end

  def update(data : String) : self
    update(Bytes.new(data.to_unsafe, data.bytesize))
  end

  private def process_block(ptr : Pointer(UInt8)) : Nil
    i = 0
    while i < 16
      @w[i] = DigestUtils.get_u32_be(ptr, i * 4)
      i = i + 1
    end
    while i < 80
      @w[i] = DigestUtils.rotl32(@w[i - 3] ^ @w[i - 8] ^ @w[i - 14] ^ @w[i - 16], 1)
      i = i + 1
    end
    a = @h0; b = @h1; c = @h2; d = @h3; e = @h4
    t = 0
    while t < 80
      if t < 20
        f = (b & c) | ((b ^ 0xffffffff_u64) & d)
        k = 0x5a827999_u64
      elsif t < 40
        f = b ^ c ^ d
        k = 0x6ed9eba1_u64
      elsif t < 60
        f = (b & c) | (b & d) | (c & d)
        k = 0x8f1bbcdc_u64
      else
        f = b ^ c ^ d
        k = 0xca62c1d6_u64
      end
      temp = (DigestUtils.rotl32(a, 5) &+ f &+ e &+ k &+ @w[t]) & 0xffffffff_u64
      e = d; d = c; c = DigestUtils.rotl32(b, 30); b = a; a = temp
      t = t + 1
    end
    @h0 = (@h0 &+ a) & 0xffffffff_u64
    @h1 = (@h1 &+ b) & 0xffffffff_u64
    @h2 = (@h2 &+ c) & 0xffffffff_u64
    @h3 = (@h3 &+ d) & 0xffffffff_u64
    @h4 = (@h4 &+ e) & 0xffffffff_u64
  end

  def final : Bytes
    return out_digest if @finished
    @finished = true
    bit_len = @total_bytes.unsafe_shl(3_u64)
    @buffer[@buffer_len] = 0x80_u8
    @buffer_len = @buffer_len + 1
    if @buffer_len > 56
      while @buffer_len < 64
        @buffer[@buffer_len] = 0_u8
        @buffer_len = @buffer_len + 1
      end
      process_block(@buffer)
      @buffer_len = 0
    end
    while @buffer_len < 56
      @buffer[@buffer_len] = 0_u8
      @buffer_len = @buffer_len + 1
    end
    DigestUtils.put_u64_be(@buffer, 56, bit_len)
    process_block(@buffer)
    out_digest
  end

  private def out_digest : Bytes
    out = Bytes.new(20)
    ptr = out.to_unsafe
    DigestUtils.put_u32_be(ptr, 0, @h0)
    DigestUtils.put_u32_be(ptr, 4, @h1)
    DigestUtils.put_u32_be(ptr, 8, @h2)
    DigestUtils.put_u32_be(ptr, 12, @h3)
    DigestUtils.put_u32_be(ptr, 16, @h4)
    out
  end

  def hexdigest : String
    final.hexstring
  end

  def self.digest(data : Bytes) : Bytes
    new.update(data).final
  end

  def self.digest(data : String) : Bytes
    new.update(data).final
  end

  def self.hexdigest(data : Bytes) : String
    new.update(data).hexdigest
  end

  def self.hexdigest(data : String) : String
    new.update(data).hexdigest
  end

  def self.digest_size : Int32
    20
  end

  def self.block_size : Int32
    64
  end

  def digest_size : Int32
    20
  end

  def block_size : Int32
    64
  end

  def finished? : Bool
    @finished
  end
end

