  def final : Bytes
    return out_digest if @finished
    @finished = true
    bit_len = @total_bytes.unsafe_shl(3_u64)
    @buffer[@buffer_len] = 0x80_u8
    @buffer_len = @buffer_len + 1
    if @buffer_len > 56
      while @buffer_len < 64
        @buffer[@buffer_len] = 0_u8
        @buffer_len = @buffer_len + 1
      end
      process_block(@buffer)
      @buffer_len = 0
    end
    while @buffer_len < 56
      @buffer[@buffer_len] = 0_u8
      @buffer_len = @buffer_len + 1
    end
    DigestUtils.put_u64_be(@buffer, 56, bit_len)
    process_block(@buffer)
    out_digest
  end

  private def out_digest : Bytes
    out = Bytes.new(32)
    ptr = out.to_unsafe
    DigestUtils.put_u32_be(ptr, 0, @h0)
    DigestUtils.put_u32_be(ptr, 4, @h1)
    DigestUtils.put_u32_be(ptr, 8, @h2)
    DigestUtils.put_u32_be(ptr, 12, @h3)
    DigestUtils.put_u32_be(ptr, 16, @h4)
    DigestUtils.put_u32_be(ptr, 20, @h5)
    DigestUtils.put_u32_be(ptr, 24, @h6)
    DigestUtils.put_u32_be(ptr, 28, @h7)
    out
  end

  def hexdigest : String
    final.hexstring
  end

  def self.digest(data : Bytes) : Bytes
    new.update(data).final
  end

  def self.digest(data : String) : Bytes
    new.update(data).final
  end

  def self.hexdigest(data : Bytes) : String
    new.update(data).hexdigest
  end

  def self.hexdigest(data : String) : String
    new.update(data).hexdigest
  end

  def self.digest_size : Int32
    32
  end

  def self.block_size : Int32
    64
  end

  def digest_size : Int32
    32
  end

  def block_size : Int32
    64
  end

  def finished? : Bool
    @finished
  end
end

pub class SHA512
  @h0 : UInt64 = 0x6a09e667f3bcc908_u64
  @h1 : UInt64 = 0xbb67ae8584caa73b_u64
  @h2 : UInt64 = 0x3c6ef372fe94f82b_u64
  @h3 : UInt64 = 0xa54ff53a5f1d36f1_u64
  @h4 : UInt64 = 0x510e527fade682d1_u64
  @h5 : UInt64 = 0x9b05688c2b3e6c1f_u64
  @h6 : UInt64 = 0x1f83d9abfb41bd6b_u64
  @h7 : UInt64 = 0x5be0cd19137e2179_u64
  @buffer : Pointer(UInt8)
  @buffer_len : Int32 = 0
  @total_bytes : UInt64 = 0_u64
  @w : Pointer(UInt64)
  @finished : Bool = false

  def initialize
    @buffer = Pointer(UInt8).malloc(128_u64)
    @w = Pointer(UInt64).malloc(80_u64)
    reset
  end

  def reset : self
    @h0 = 0x6a09e667f3bcc908_u64
    @h1 = 0xbb67ae8584caa73b_u64
    @h2 = 0x3c6ef372fe94f82b_u64
    @h3 = 0xa54ff53a5f1d36f1_u64
    @h4 = 0x510e527fade682d1_u64
    @h5 = 0x9b05688c2b3e6c1f_u64
    @h6 = 0x1f83d9abfb41bd6b_u64
    @h7 = 0x5be0cd19137e2179_u64
    @buffer_len = 0
    @total_bytes = 0_u64
    @finished = false
    self
  end

  def update(data : Bytes) : self
    raise "SHA512: already finalized" if @finished
    offset = 0
    len = data.size
    @total_bytes = @total_bytes &+ len.to_u64
    if @buffer_len > 0
      needed = 128 - @buffer_len
      to_copy = len < needed ? len : needed
      i = 0
      while i < to_copy
        @buffer[@buffer_len + i] = data[offset + i]
        i = i + 1
      end
      @buffer_len = @buffer_len + to_copy
      offset = offset + to_copy
      len = len - to_copy
      if @buffer_len == 128
        process_block(@buffer)
        @buffer_len = 0
      end
    end
    while len >= 128
      process_block(data.to_unsafe + offset.to_i64)
      offset = offset + 128
      len = len - 128
    end
    if len > 0
      i = 0
      while i < len
        @buffer[i] = data[offset + i]
        i = i + 1
      end
      @buffer_len = len
    end
    self
  end

  def update(data : String) : self
    update(Bytes.new(data.to_unsafe, data.bytesize))
  end

