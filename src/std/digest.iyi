    @h1 = @h1 &+ b
    @h2 = @h2 &+ c
    @h3 = @h3 &+ d
    @h4 = @h4 &+ e
    @h5 = @h5 &+ f
    @h6 = @h6 &+ g
    @h7 = @h7 &+ h
  end

  def final : Bytes
    return out_digest if @finished
    @finished = true
    bit_len = @total_bytes.unsafe_shl(3_u64)
    @buffer[@buffer_len] = 0x80_u8
    @buffer_len = @buffer_len + 1
    if @buffer_len > 112
      while @buffer_len < 128
        @buffer[@buffer_len] = 0_u8
        @buffer_len = @buffer_len + 1
      end
      process_block(@buffer)
      @buffer_len = 0
    end
    while @buffer_len < 112
      @buffer[@buffer_len] = 0_u8
      @buffer_len = @buffer_len + 1
    end
    DigestUtils.put_u64_be(@buffer, 112, 0_u64)
    DigestUtils.put_u64_be(@buffer, 120, bit_len)
    process_block(@buffer)
    out_digest
  end

  private def out_digest : Bytes
    out = Bytes.new(64)
    ptr = out.to_unsafe
    DigestUtils.put_u64_be(ptr, 0, @h0)
    DigestUtils.put_u64_be(ptr, 8, @h1)
    DigestUtils.put_u64_be(ptr, 16, @h2)
    DigestUtils.put_u64_be(ptr, 24, @h3)
    DigestUtils.put_u64_be(ptr, 32, @h4)
    DigestUtils.put_u64_be(ptr, 40, @h5)
    DigestUtils.put_u64_be(ptr, 48, @h6)
    DigestUtils.put_u64_be(ptr, 56, @h7)
    out
  end

  def hexdigest : String
    final.hexstring
  end

  def self.digest(data : Bytes) : Bytes
    new.update(data).final
  end

  def self.digest(data : String) : Bytes
    new.update(data).final
  end

  def self.hexdigest(data : Bytes) : String
    new.update(data).hexdigest
  end

  def self.hexdigest(data : String) : String
    new.update(data).hexdigest
  end

  def self.digest_size : Int32
    64
  end

  def self.block_size : Int32
    128
  end

  def digest_size : Int32
    64
  end

  def block_size : Int32
    128
  end

  def finished? : Bool
    @finished
  end
end

pub class SHA384 < SHA512
  def reset : self
    @h0 = 0xcbbb9d5dc1059ed8_u64
    @h1 = 0x629a292a367cd507_u64
