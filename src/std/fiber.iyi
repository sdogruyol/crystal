# Crystal-compatible Fiber API — fiber inspection, cooperative scheduling,
# and execution state tracking built on iyi's native IyiFiber runtime.

module std/fiber

class ::IyiFiber
  property name : String?

  def running? : Bool
    @state == 0
  end

  def resumable? : Bool
    @state == 1 || @state == 2 || @state == 3 || @state == 4 || @state == 5
  end

  def dead? : Bool
    @state == 6
  end

  def enqueue : Nil
    IyiScheduler.enqueue(self)
  end

  def resume : Nil
    IyiScheduler.enqueue(self)
  end

  def to_s : String
    if n = @name
      "#<Fiber:0x#{object_id.to_s(16)} #{n}>"
    else
      "#<Fiber:0x#{object_id.to_s(16)}>"
    end
  end

  def inspect : String
    to_s
  end

  def ==(other : IyiFiber) : Bool
    self.object_id == other.object_id
  end

  def same?(other : IyiFiber) : Bool
    self.object_id == other.object_id
  end

  def self.current : IyiFiber
    IyiScheduler.current
  end

  def self.current? : IyiFiber?
    IyiScheduler.current
  end

  def self.yield : Nil
    IyiScheduler.enqueue(IyiScheduler.current)
    IyiScheduler.reschedule
  end

  def self.suspend : Nil
    IyiScheduler.reschedule
  end

  def self.new(name : String? = nil, &proc : ->) : IyiFiber
    f = IyiFiber.new
    f.name = name
    f.proc = proc
    f.prepare_stack
    IyiScheduler.register(f)
    f
  end
end

pub alias Fiber = ::IyiFiber
