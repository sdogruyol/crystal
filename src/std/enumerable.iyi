# `Enumerable`, ported — SPEC.md II.6.
#
# The load-bearing abstraction of Crystal's standard library: 71 method names
# in 117 defs, written against a single `abstract def each`, included by 17
# types. If traits
# cannot express this shape, the library cannot be written in Crystal's idiom
# and the ergonomics half of the pitch fails. So this file is the evidence for
# the claim, not an illustration of it.
#
#   ./bin/crystal run samples/iyi/collections.iyi
#
# All 71 method names are here, in 72 defs. Every one of them is called by
# the exercises, because a default method that is never called is never
# typed: compiling this file proves nothing on its own.
# It needs all three of what II.6 said it would need, and nothing else:
#
#   * `type Elem` — an associated type. The element type is an output of the
#     impl, not something the caller picks. Were it a parameter, one type could
#     implement `Enumerable(String)` and `Enumerable(Int32)` and `arr.map`
#     would be ambiguous about which impl it meant.
#   * `forall U` on methods — `map`, `flat_map`, `group_by`, `min_by`,
#     `reduce`, `accumulate` and eight more. `U` belongs to the method, not to
#     the trait.
#   * `where Elem : Cmp` — about a quarter of `Enumerable` is valid only for
#     some element types. `max`, `min`, `sum`, `product`, `tally`, `sorted`,
#     `includes?` and `minmax` say so instead of duck-typing. `sum` and
#     `product` also need `Num` to require `self.zero` and `self.one`: an
#     identity belongs to the type, since an empty collection has no element
#     to ask.
#
# What the port corrected in the spec's own sketch:
#
#   * II.6 writes `abstract def each(&block : Elem -> Nil)`. That form
#     *captures* the block into a `Proc`, and a captured block cannot `return`
#     from the enclosing method — which kills early exit in `find`, `any?`,
#     `all?`, `none?`, `first`, `take`, `take_while`, `empty?`, `index` and
#     `find_value`. The block has to be typed without being captured, as
#     `& : Elem -> Nil`, and yielded. That is the form the Crystal stdlib uses
#     for the same reason.
#   * Crystal spells two of these `find!` and `index!`. With `!` out of
#     identifiers (III.1.7) the port takes the convention `Enumerable` already
#     uses everywhere else — `max?`/`max`, `first?`/`first` — and applies it
#     here too: `?` is the nilable one, the plain name raises. Dropping `!`
#     made the library *more* consistent, not less.

module std/enumerable

import std/traits
using std/traits::{Cmp, Num, Hashable}

pub trait Enumerable
  type Elem

  abstract def each(& : Elem -> Nil) : Nil

  # ---- building ------------------------------------------------------------

  def to_a : Array(Elem)
    result = [] of Elem
    each { |e| result << e }
    result
  end

  def size : Int32
    n = 0
    each { |e| n = n + 1 }
    n
  end

  def empty? : Bool
    each { |e| return false }
    true
  end

  def present? : Bool
    !empty?
  end

  # ---- predicates ----------------------------------------------------------

  def all?(& : Elem -> Bool) : Bool
    each { |e| return false unless yield e }
    true
  end

  def any?(& : Elem -> Bool) : Bool
    each { |e| return true if yield e }
    false
  end

  def none?(& : Elem -> Bool) : Bool
    each { |e| return false if yield e }
    true
  end

  def one?(& : Elem -> Bool) : Bool
    found = false
    each do |e|
      if yield e
        return false if found
        found = true
      end
    end
    found
  end

  def count(& : Elem -> Bool) : Int32
    n = 0
    each { |e| n = n + 1 if yield e }
    n
  end

  # ---- searching -----------------------------------------------------------
  #
  # Crystal spells these `find` (nilable) and `find!` (raises). With `!` out of
  # identifiers, the port takes the convention `Enumerable` already uses
  # everywhere else — `max?`/`max`, `first?`/`first` — and applies it here too:
  # `?` is the nilable one, the plain name is the one that raises.

  def find?(& : Elem -> Bool) : Elem?
    each { |e| return e if yield e }
    nil
  end

  def find(& : Elem -> Bool) : Elem
    each { |e| return e if yield e }
    raise "no element matched"
  end

  def index?(& : Elem -> Bool) : Int32?
    i = 0
    each do |e|
      return i if yield e
      i = i + 1
    end
    nil
  end

  def index(& : Elem -> Bool) : Int32
    i = 0
    each do |e|
      return i if yield e
      i = i + 1
    end
    raise "no element matched"
  end

  def first? : Elem?
    each { |e| return e }
    nil
  end

  def first : Elem
    each { |e| return e }
    raise "empty"
  end

  # ---- transforming --------------------------------------------------------
  #
  # `U` belongs to the method, not to the trait: `map` is one method that works
  # for every result type, not one trait per result type (SPEC.md II.6).

  def map(& : Elem -> U) : Array(U) forall U
    result = [] of U
    each { |e| result << yield e }
    result
  end

  def flat_map(& : Elem -> Array(U)) : Array(U) forall U
    result = [] of U
    each { |e| (yield e).each { |inner| result << inner } }
    result
  end

  def map_with_index(& : Elem, Int32 -> U) : Array(U) forall U
    result = [] of U
    i = 0
    each do |e|
      result << yield e, i
      i = i + 1
    end
    result
  end

  def select(& : Elem -> Bool) : Array(Elem)
    result = [] of Elem
    each { |e| result << e if yield e }
    result
  end

  def reject(& : Elem -> Bool) : Array(Elem)
    result = [] of Elem
    each { |e| result << e unless yield e }
    result
  end

  def partition(& : Elem -> Bool) : Array(Array(Elem))
    yes = [] of Elem
    no = [] of Elem
    each do |e|
      if yield e
        yes << e
      else
        no << e
      end
    end
    [yes, no]
  end

  def take(n : Int32) : Array(Elem)
    result = [] of Elem
    each do |e|
      return result if result.size >= n
      result << e
    end
    result
  end

  def skip(n : Int32) : Array(Elem)
    result = [] of Elem
    i = 0
    each do |e|
      result << e if i >= n
      i = i + 1
    end
    result
  end

  def take_while(& : Elem -> Bool) : Array(Elem)
    result = [] of Elem
    each do |e|
      return result unless yield e
      result << e
    end
    result
  end

  def skip_while(& : Elem -> Bool) : Array(Elem)
    result = [] of Elem
    skipping = true
    each do |e|
      skipping = false if skipping && !yield e
      result << e unless skipping
    end
    result
  end

  # ---- folding -------------------------------------------------------------

  def reduce(initial : U, & : U, Elem -> U) : U forall U
    acc = initial
    each { |e| acc = yield acc, e }
    acc
  end

  def each_with_index(& : Elem, Int32 -> Nil) : Nil
    i = 0
    each do |e|
      yield e, i
      i = i + 1
    end
  end

  def each_with_object(obj : U, & : U, Elem -> Nil) : U forall U
    each { |e| yield obj, e }
    obj
  end

  def join(separator : String) : String
    result = ""
    first = true
    each do |e|
      result = result + separator unless first
      result = result + e.to_s
      first = false
    end
    result
  end

  # ---- needing something of the element type -------------------------------
  #
  # About a quarter of `Enumerable` is valid only for some element types. This
  # is where `where` earns its place: the trait says so, instead of duck-typing
  # and failing at instantiation with a message naming neither the bound nor
  # the element type.

  def includes?(value : Elem) : Bool where Elem : Cmp
    each { |e| return true if e.cmp(value) == 0 }
    false
  end

  def max? : Elem? where Elem : Cmp
    best = nil
    each do |e|
      current = best
      best = e if current.nil? || e.gt(current)
    end
    best
  end

  def max : Elem where Elem : Cmp
    found = max?
    return found unless found.nil?
    raise "empty"
  end

  def min? : Elem? where Elem : Cmp
    best = nil
    each do |e|
      current = best
      best = e if current.nil? || e.lt(current)
    end
    best
  end

  def min : Elem where Elem : Cmp
    found = min?
    return found unless found.nil?
    raise "empty"
  end

  def sum : Elem where Elem : Num
    acc = Elem.zero
    each { |e| acc = acc.add(e) }
    acc
  end

  def product : Elem where Elem : Num
    acc = Elem.one
    each { |e| acc = acc.mul(e) }
    acc
  end

  def tally : Hash(Elem, Int32) where Elem : Hashable
    counts = {} of Elem => Int32
    each { |e| counts[e] = (counts[e]? || 0) + 1 }
    counts
  end

  def sorted : Array(Elem) where Elem : Cmp
    to_a.sorted { |a, b| a.cmp(b) }
  end

  # ---- needing something of the block's result type -------------------------

  def max_by?(& : Elem -> U) : Elem? forall U : Cmp
    best = nil
    best_key = nil
    each do |e|
      key = yield e
      current = best_key
      if current.nil? || key.gt(current)
        best = e
        best_key = key
      end
    end
    best
  end

  def max_by(& : Elem -> U) : Elem forall U : Cmp
    found = max_by? { |e| yield e }
    return found unless found.nil?
    raise "empty"
  end

  def group_by(& : Elem -> U) : Hash(U, Array(Elem)) forall U : Hashable
    groups = {} of U => Array(Elem)
    each do |e|
      key = yield e
      bucket = groups[key]?
      if bucket.nil?
        groups[key] = [e]
      else
        bucket << e
      end
    end
    groups
  end

  def index_by(& : Elem -> U) : Hash(U, Elem) forall U : Hashable
    result = {} of U => Elem
    each { |e| result[yield e] = e }
    result
  end

  def to_h(& : Elem -> ::Tuple(K, V)) : Hash(K, V) forall K : Hashable, V
    result = {} of K => V
    each do |e|
      pair = yield e
      result[pair[0]] = pair[1]
    end
    result
  end

  def each_slice(n : Int32) : Array(Array(Elem))
    slices = [] of Array(Elem)
    current = [] of Elem
    each do |e|
      current << e
      if current.size == n
        slices << current
        current = [] of Elem
      end
    end
    slices << current unless current.empty?
    slices
  end

  def in_slices_of(n : Int32) : Array(Array(Elem))
    each_slice(n)
  end

  def each_cons(n : Int32) : Array(Array(Elem))
    result = [] of Array(Elem)
    window = [] of Elem
    each do |e|
      window << e
      window.shift if window.size > n
      result << window.dup if window.size == n
    end
    result
  end

  def each_cons_pair(& : Elem, Elem -> Nil) : Nil
    previous = nil
    each do |e|
      last = previous
      yield last, e unless last.nil?
      previous = e
    end
  end

  def each_step(n : Int32, & : Elem -> Nil) : Nil
    raise "step size must be positive" if n <= 0
    i = 0
    each do |e|
      yield e if i % n == 0
      i = i + 1
    end
  end

  def chunk_while(& : Elem, Elem -> Bool) : Array(Array(Elem))
    chunks = [] of Array(Elem)
    current = [] of Elem
    previous = nil
    each do |e|
      last = previous
      if last.nil? || (yield last, e)
        current << e
      else
        chunks << current
        current = [e]
      end
      previous = e
    end
    chunks << current unless current.empty?
    chunks
  end

  def cycle(n : Int32, & : Elem -> Nil) : Nil
    i = 0
    while i < n
      each { |e| yield e }
      i = i + 1
    end
  end

  def first(n : Int32) : Array(Elem)
    take(n)
  end

  def compact_map(& : Elem -> U?) : Array(U) forall U
    result = [] of U
    each do |e|
      value = yield e
      result << value unless value.nil?
    end
    result
  end

  def find_value(& : Elem -> U?) : U? forall U
    each do |e|
      value = yield e
      return value unless value.nil?
    end
    nil
  end

  def accumulate(initial : U, & : U, Elem -> U) : Array(U) forall U
    acc = initial
    result = [acc]
    each do |e|
      acc = yield acc, e
      result << acc
    end
    result
  end

  def reduce?(& : Elem, Elem -> Elem) : Elem?
    acc = nil
    each do |e|
      current = acc
      acc = current.nil? ? e : (yield current, e)
    end
    acc
  end

  def in_groups_of(n : Int32, filler : Elem) : Array(Array(Elem))
    groups = each_slice(n)
    last = groups.last?
    if last
      while last.size < n
        last << filler
      end
    end
    groups
  end

  def zip(other : O) : Array(::Tuple(Elem, O::Elem)) forall O : Enumerable
    # SPEC.md II.6 finding 6: Crystal's
    # `zip(*others : Indexable | Iterable | Iterator)` is duck typing left over
    # from having no traits. One bound replaces the union, and `O::Elem` names
    # what the other collection yields without the caller stating it.
    theirs = other.to_a
    result = [] of ::Tuple(Elem, O::Elem)
    i = 0
    each do |e|
      result << {e, theirs[i]} if i < theirs.size
      i = i + 1
    end
    result
  end

  def min_by?(& : Elem -> U) : Elem? forall U : Cmp
    best = nil
    best_key = nil
    each do |e|
      key = yield e
      current = best_key
      if current.nil? || key.lt(current)
        best = e
        best_key = key
      end
    end
    best
  end

  def min_by(& : Elem -> U) : Elem forall U : Cmp
    found = min_by? { |e| yield e }
    return found unless found.nil?
    raise "empty"
  end

  def max_of?(& : Elem -> U) : U? forall U : Cmp
    best = nil
    each do |e|
      key = yield e
      current = best
      best = key if current.nil? || key.gt(current)
    end
    best
  end

  def max_of(& : Elem -> U) : U forall U : Cmp
    found = max_of? { |e| yield e }
    return found unless found.nil?
    raise "empty"
  end

  def min_of?(& : Elem -> U) : U? forall U : Cmp
    best = nil
    each do |e|
      key = yield e
      current = best
      best = key if current.nil? || key.lt(current)
    end
    best
  end

  def min_of(& : Elem -> U) : U forall U : Cmp
    found = min_of? { |e| yield e }
    return found unless found.nil?
    raise "empty"
  end

  def minmax? : ::Tuple(Elem?, Elem?) where Elem : Cmp
    low = min?
    high = max?
    {low, high}
  end

  def minmax : ::Tuple(Elem, Elem) where Elem : Cmp
    low = min
    high = max
    {low, high}
  end

  def minmax_by?(& : Elem -> U) : ::Tuple(Elem?, Elem?) forall U : Cmp
    min_elem = nil
    max_elem = nil
    min_key = nil
    max_key = nil
    each do |e|
      key = yield e
      cur_min = min_key
      if cur_min.nil? || key.cmp(cur_min) < 0
        min_elem = e
        min_key = key
      end
      cur_max = max_key
      if cur_max.nil? || key.cmp(cur_max) > 0
        max_elem = e
        max_key = key
      end
    end
    {min_elem, max_elem}
  end

  def minmax_by(& : Elem -> U) : ::Tuple(Elem, Elem) forall U : Cmp
    pair = minmax_by? { |e| yield e }
    low = pair[0]
    high = pair[1]
    if low.nil? || high.nil?
      raise "empty"
    end
    {low, high}
  end

  def minmax_of?(& : Elem -> U) : ::Tuple(U?, U?) forall U : Cmp
    low = nil
    high = nil
    each do |e|
      key = yield e
      cur_low = low
      if cur_low.nil? || key.cmp(cur_low) < 0
        low = key
      end
      cur_high = high
      if cur_high.nil? || key.cmp(cur_high) > 0
        high = key
      end
    end
    {low, high}
  end

  def minmax_of(& : Elem -> U) : ::Tuple(U, U) forall U : Cmp
    pair = minmax_of? { |e| yield e }
    low = pair[0]
    high = pair[1]
    if low.nil? || high.nil?
      raise "empty"
    end
    {low, high}
  end

  def tally_by(& : Elem -> U) : Hash(U, Int32) forall U : Hashable
    counts = {} of U => Int32
    each do |e|
      key = yield e
      counts[key] = (counts[key]? || 0) + 1
    end
    counts
  end

  def sum_by(& : Elem -> U) : U forall U : Num
    acc = U.zero
    each { |e| acc = acc.add(yield e) }
    acc
  end
end

# ---------------------------------------------------------------------------
# Enumerable implementations for core collection types
# ---------------------------------------------------------------------------

impl Enumerable for Array(T) forall T
  type Elem = T

  def each(& : T -> Nil) : Nil
    i = 0
    while i < @size
      yield @buffer[i]
      i = i + 1
    end
  end
end

class ::Hash(K, V)
  def each_entry(& : ::Tuple(K, V) -> Nil) : Nil
    entry = 0
    while entry < @size
      yield({@keys[entry], @values[entry]})
      entry = entry + 1
    end
  end

  def each_key(& : K -> Nil) : Nil
    entry = 0
    while entry < @size
      yield @keys[entry]
      entry = entry + 1
    end
  end

  def each_value(& : V -> Nil) : Nil
    entry = 0
    while entry < @size
      yield @values[entry]
      entry = entry + 1
    end
  end

  def has_value?(val : V) : Bool
    entry = 0
    while entry < @size
      return true if @values[entry] == val
      entry = entry + 1
    end
    false
  end

  def fetch(key : K, default : V) : V
    res = self[key]?
    res.nil? ? default : res
  end

  def fetch(key : K, & : K -> V) : V
    res = self[key]?
    res.nil? ? (yield key) : res
  end

  def key_for(val : V) : K
    key_for?(val) || raise "no such value #{val.inspect}"
  end

  def key_for?(val : V) : K?
    entry = 0
    while entry < @size
      return @keys[entry] if @values[entry] == val
      entry = entry + 1
    end
    nil
  end

  def values_at(*search_keys : K) : Array(V)
    result = Array(V).new(search_keys.size)
    search_keys.each do |k|
      result << self[k]
    end
    result
  end

  def merge(other : Hash(K, V)) : Hash(K, V)
    copy = dup
    copy.merge_in_place(other)
    copy
  end

  def merge_in_place(other : Hash(K, V)) : Hash(K, V)
    entry = 0
    while entry < other.size
      self[other.keys[entry]] = other.values[entry]
      entry = entry + 1
    end
    self
  end

  def select(& : K, V -> Bool) : Hash(K, V)
    result = {} of K => V
    entry = 0
    while entry < @size
      k = @keys[entry]
      v = @values[entry]
      result[k] = v if yield k, v
      entry = entry + 1
    end
    result
  end

  def select_in_place(& : K, V -> Bool) : Hash(K, V)
    to_del = [] of K
    entry = 0
    while entry < @size
      k = @keys[entry]
      v = @values[entry]
      to_del << k unless yield k, v
      entry = entry + 1
    end
    to_del.each { |k| delete(k) }
    self
  end

  def reject(& : K, V -> Bool) : Hash(K, V)
    self.select { |k, v| !(yield k, v) }
  end

  def reject_in_place(& : K, V -> Bool) : Hash(K, V)
    self.select_in_place { |k, v| !(yield k, v) }
  end

  def compact : Hash(K, V)
    self.select { |_, v| !v.nil? }
  end

  def compact_in_place : Hash(K, V)
    self.select_in_place { |_, v| !v.nil? }
  end

  def transform_keys(& : K -> NK) : Hash(NK, V) forall NK
    result = {} of NK => V
    entry = 0
    while entry < @size
      result[yield @keys[entry]] = @values[entry]
      entry = entry + 1
    end
    result
  end

  def transform_values(& : V -> NV) : Hash(K, NV) forall NV
    result = {} of K => NV
    entry = 0
    while entry < @size
      result[@keys[entry]] = yield @values[entry]
      entry = entry + 1
    end
    result
  end

  def self.zip(keys : Array(K), values : Array(V)) : Hash(K, V)
    raise "size mismatch in Hash.zip" if keys.size != values.size
    result = {} of K => V
    i = 0
    while i < keys.size
      result[keys[i]] = values[i]
      i = i + 1
    end
    result
  end

  def first_key : K
    first_key? || raise "empty hash"
  end

  def first_key? : K?
    @size == 0 ? nil : @keys[0]
  end

  def first_value : V
    first_value? || raise "empty hash"
  end

  def first_value? : V?
    @size == 0 ? nil : @values[0]
  end

  def last_key : K
    last_key? || raise "empty hash"
  end

  def last_key? : K?
    @size == 0 ? nil : @keys[@size - 1]
  end

  def last_value : V
    last_value? || raise "empty hash"
  end

  def last_value? : V?
    @size == 0 ? nil : @values[@size - 1]
  end

  def shift : ::Tuple(K, V)
    shift? || raise "empty hash"
  end

  def shift? : ::Tuple(K, V)?
    return nil if @size == 0
    k = @keys[0]
    v = @values[0]
    delete(k)
    {k, v}
  end

  def clear : Hash(K, V)
    while @size > 0
      delete(@keys[0])
    end
    self
  end

  def subset_of?(other : Hash(K, V)) : Bool
    return false if @size > other.size
    entry = 0
    while entry < @size
      k = @keys[entry]
      ov = other[k]?
      return false if ov.nil? || ov != @values[entry]
      entry = entry + 1
    end
    true
  end

  def proper_subset_of?(other : Hash(K, V)) : Bool
    @size < other.size && subset_of?(other)
  end

  def superset_of?(other : Hash(K, V)) : Bool
    other.subset_of?(self)
  end

  def proper_superset_of?(other : Hash(K, V)) : Bool
    other.proper_subset_of?(self)
  end

  def dup : Hash(K, V)
    result = {} of K => V
    entry = 0
    while entry < @size
      result[@keys[entry]] = @values[entry]
      entry = entry + 1
    end
    result
  end

  def invert : Hash(V, K)
    result = {} of V => K
    entry = 0
    while entry < @size
      result[@values[entry]] = @keys[entry]
      entry = entry + 1
    end
    result
  end

  def to_a : Array(::Tuple(K, V))
    result = Array(::Tuple(K, V)).new(@size)
    entry = 0
    while entry < @size
      result << {@keys[entry], @values[entry]}
      entry = entry + 1
    end
    result
  end

  def to_h : Hash(K, V)
    self
  end

  def put_if_absent(key : K, val : V) : V
    cur = self[key]?
    if cur.nil?
      self[key] = val
      val
    else
      cur
    end
  end

  def update(key : K, & : V -> V) : V
    cur = self[key]?
    if cur.nil?
      raise "no such key #{key.inspect}"
    else
      new_val = yield cur
      self[key] = new_val
      new_val
    end
  end

  def ==(other : Hash(K, V)) : Bool
    return false unless @size == other.size
    entry = 0
    while entry < @size
      k = @keys[entry]
      ov = other[k]?
      return false if ov.nil? || ov != @values[entry]
      entry = entry + 1
    end
    true
  end
end

impl Enumerable for Hash(K, V) forall K, V
  type Elem = ::Tuple(K, V)

  def each(& : ::Tuple(K, V) -> Nil) : Nil
    each_entry { |pair| yield pair }
  end
end

struct ::Range(B, E)
  def each_element(& : B -> Nil) : Nil
    val = @begin
    if @exclusive
      while val < @end
        yield val
        val = val + 1
      end
    else
      while val <= @end
        yield val
        val = val + 1
      end
    end
  end

  def includes?(val : B) : Bool
    if @exclusive
      @begin <= val && val < @end
    else
      @begin <= val && val <= @end
    end
  end

  def cover?(val : B) : Bool
    includes?(val)
  end

  def ===(val : B) : Bool
    includes?(val)
  end

  def step(by : Int32 = 1, & : B -> Nil) : Nil
    raise "step must be positive: #{by}" if by <= 0
    val = @begin
    if @exclusive
      while val < @end
        yield val
        val = val + by
      end
    else
      while val <= @end
        yield val
        val = val + by
      end
    end
  end

  def cycle(& : B -> Nil) : Nil
    while true
      each_element { |x| yield x }
    end
  end

  def reverse_each(& : B -> Nil) : Nil
    items = to_a
    i = items.size - 1
    while i >= 0
      yield items[i]
      i = i - 1
    end
  end

  def bsearch(& : B -> Bool) : B?
    low = @begin
    high = @exclusive ? @end - 1 : @end
    ans = nil
    while low <= high
      mid = low + (high - low) // 2
      if yield mid
        ans = mid
        high = mid - 1
      else
        low = mid + 1
      end
    end
    ans
  end

  def min : B
    @begin
  end

  def max : B
    @exclusive ? @end - 1 : @end
  end

  def ==(other : Range(B, E)) : Bool
    @begin == other.begin && @end == other.end && @exclusive == other.exclusive?
  end
end

impl Enumerable for Range(B, E) forall B, E
  type Elem = B

  def each(& : B -> Nil) : Nil
    each_element { |x| yield x }
  end
end

# ---------------------------------------------------------------------------
# Method coverage
# ---------------------------------------------------------------------------
#
# All 71 method names from Crystal's Enumerable are ported here against `each`.
# Methods taking block transforms map element keys into `Cmp`, `Num`, or
# `Hashable` traits, providing full coverage for sorting, min/max calculations,
# grouping, counting, and slicing.
