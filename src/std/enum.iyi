module std/enum

import std/traits
using std/traits::{Cmp}

# Enum is the base type of all enums.
abstract struct ::Enum
  def to_i : Int32
    value.to_i32
  end

  def to_i8 : Int8
    value.to_i8
  end

  def to_i16 : Int16
    value.to_i16
  end

  def to_i32 : Int32
    value.to_i32
  end

  def to_i64 : Int64
    value.to_i64
  end

  def to_u8 : UInt8
    value.to_u8
  end

  def to_u16 : UInt16
    value.to_u16
  end

  def to_u32 : UInt32
    value.to_u32
  end

  def to_u64 : UInt64
    value.to_u64
  end

  def to_f32 : Float32
    value.to_f32
  end

  def to_f64 : Float64
    value.to_f64
  end

  def +(other : Int) : self
    self.class.new(value + other)
  end

  def -(other : Int) : self
    self.class.new(value - other)
  end

  def |(other : self) : self
    self.class.new(value | other.value)
  end

  def &(other : self) : self
    self.class.new(value & other.value)
  end

  def ^(other : self) : self
    self.class.new(value ^ other.value)
  end

  def ~ : self
    self.class.new(~value)
  end

  def <=>(other : self) : Int32
    v1 = value
    v2 = other.value
    v1 < v2 ? -1 : (v1 > v2 ? 1 : 0)
  end

  def <(other : self) : ::Bool
    value < other.value
  end

  def <=(other : self) : ::Bool
    value <= other.value
  end

  def >(other : self) : ::Bool
    value > other.value
  end

  def >=(other : self) : ::Bool
    value >= other.value
  end

  def ==(other : self) : ::Bool
    value == other.value
  end

  def includes?(other : self) : ::Bool
    (value & other.value) == other.value
  end

  def hash : Int32
    value
  end

  def clone : self
    self
  end

  def to_s : String
    {% for member in @type.constants %}
      if value == {{@type.constant(member)}}
        return {{member.stringify}}
      end
    {% end %}
    value.to_s
  end

  def to_s(io : IyiIO) : ::Nil
    io.print(to_s)
  end

  def inspect : String
    to_s
  end

  def inspect(io : IyiIO) : ::Nil
    io.print(inspect)
  end

  def self.names : Array(String)
    {{ @type.constants.map &.stringify }}
  end

  def self.values : Array(self)
    {% begin %}
      arr = [] of self
      {% for member in @type.constants %}
        arr << new({{@type.constant(member)}})
      {% end %}
      arr
    {% end %}
  end

  def self.from_value?(val : Int) : self?
    {% for member in @type.constants %}
      return new({{@type.constant(member)}}) if {{@type.constant(member)}} == val
    {% end %}
    nil
  end

  def self.from_value(val : Int) : self
    from_value?(val) || raise "Unknown enum value: #{val}"
  end

  def self.valid?(val : self) : ::Bool
    !from_value?(val.value).nil?
  end

  def self.parse?(string : String) : self?
    {% for member in @type.constants %}
      if string == {{member.stringify}}
        return new({{@type.constant(member)}})
      end
    {% end %}
    nil
  end

  def self.parse(string : String) : self
    parse?(string) || raise "Unknown enum name: #{string}"
  end

  def self.each(& : self -> ::Nil) : ::Nil
    {% for member in @type.constants %}
      yield new({{@type.constant(member)}})
    {% end %}
  end
end
