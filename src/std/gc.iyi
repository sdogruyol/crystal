# Garbage Collector interface for iyi runtime.
#
# Provides memory allocation, statistics, and GC control wrappers.

module std/gc

module ::GC
  struct Stats
    getter heap_size : UInt64
    getter free_bytes : UInt64
    getter unmapped_bytes : UInt64
    getter bytes_since_gc : UInt64
    getter total_bytes : UInt64

    def initialize(@heap_size : UInt64, @free_bytes : UInt64, @unmapped_bytes : UInt64, @bytes_since_gc : UInt64, @total_bytes : UInt64)
    end

    def copy_with(heap_size = @heap_size, free_bytes = @free_bytes, unmapped_bytes = @unmapped_bytes, bytes_since_gc = @bytes_since_gc, total_bytes = @total_bytes) : Stats
      Stats.new(heap_size, free_bytes, unmapped_bytes, bytes_since_gc, total_bytes)
    end

    def clone : Stats
      Stats.new(@heap_size, @free_bytes, @unmapped_bytes, @bytes_since_gc, @total_bytes)
    end
  end

  record ProfStats,
    heap_size : UInt64,
    free_bytes : UInt64,
    unmapped_bytes : UInt64,
    bytes_since_gc : UInt64,
    bytes_before_gc : UInt64,
    non_gc_bytes : UInt64,
    gc_no : UInt64,
    markers_m1 : UInt64,
    bytes_reclaimed_since_gc : UInt64,
    reclaimed_bytes_before_gc : UInt64,
    expl_freed_bytes_since_gc : UInt64,
    obtained_from_os_bytes : UInt64

  # Allocates and clears size bytes of memory.
  def self.malloc(size : Int) : Void*
    __crystal_malloc64(size.to_u64)
  end

  # Allocates size bytes of pointer-free memory.
  def self.malloc_atomic(size : Int) : Void*
    __crystal_malloc_atomic64(size.to_u64)
  end

  # Reallocates memory previously allocated by malloc.
  def self.realloc(pointer : Void*, size : Int) : Void*
    __crystal_realloc64(pointer, size.to_u64)
  end

  # Frees memory if supported by the active allocator.
  def self.free(pointer : Void*) : Nil
  end

  # Runs a collection cycle.
  def self.collect : Nil
  end

  # Enables collection.
  def self.enable : Nil
  end

  # Disables collection.
  def self.disable : Nil
  end

  # Returns whether the pointer points to the GC heap.
  def self.is_heap_ptr(pointer : Void*) : Bool
    false
  end

  # Registers a disappearing link for weak reference support.
  def self.register_disappearing_link(pointer : Void**) : Nil
  end

  # Limits max heap size.
  def self.max_heap_size=(size : UInt64) : UInt64
    size
  end

  # Returns current GC allocation statistics.
  def self.stats : Stats
    Stats.new(0_u64, 0_u64, 0_u64, 0_u64, 0_u64)
  end

  # Returns profiling statistics.
  def self.prof_stats : ProfStats
    ProfStats.new(0_u64, 0_u64, 0_u64, 0_u64, 0_u64, 0_u64, 0_u64, 0_u64, 0_u64, 0_u64, 0_u64, 0_u64)
  end

  # Marks execution of a syscall block.
  def self.syscall(&proc : ->) : Nil
    proc.call
  end
end
