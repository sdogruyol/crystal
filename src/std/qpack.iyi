# Standard QPACK: Header Compression for HTTP/3 (RFC 9204)
#
# Implements:
# - RFC 9204 99-entry Static Table (Appendix A)
# - Dynamic Table with FIFO eviction by size (Section 3.2)
# - Unidirectional Encoder Stream instructions (Section 4.3):
#     * Set Dynamic Table Capacity (4.3.1)
#     * Insert with Name Reference (4.3.2)
#     * Insert with Literal Name (4.3.3)
#     * Duplicate (4.3.4)
# - Unidirectional Decoder Stream instructions (Section 4.4):
#     * Section Acknowledgment (4.4.1)
#     * Stream Cancellation (4.4.2)
#     * Insert Count Increment (4.4.3)
# - Request/Response Stream Field Line representations (Section 4.5):
#     * Encoded Field Section Prefix (4.5.1): Required Insert Count and Base
#     * Indexed Field Line (4.5.2)
#     * Indexed Field Line with Post-Base Index (4.5.3)
#     * Literal Field Line with Name Reference (4.5.4)
#     * Literal Field Line with Post-Base Name Reference (4.5.5)
#     * Literal Field Line with Literal Name (4.5.6)
# - Out-of-order stream handling:
#     * Blocked stream tracking and limit enforcement (SETTINGS_QPACK_BLOCKED_STREAMS)
#     * Immediate detection and rejection of unsatisfiable Required Insert Count
#     * Automatic resolution and decoding when table entries arrive
# - Security defenses:
#     * Decompression bomb protection: bounds decoded uncompressed header size
#     * Dynamic table capacity limit enforcement (SETTINGS_QPACK_MAX_TABLE_CAPACITY)
#     * Never-indexed (N-bit) protection preserved
#
# Primitives:
# - Prefix integers and Canonical Huffman encoding are reused from RFC 7541
#   via std/hpack (owned by StdHpack).

module std/qpack

import std/traits
import std/slice
import std/text
import std/hpack

using std/slice::{Slice, Bytes}
using std/hpack::{Integer, Huffman, HpackError}

# ---------------------------------------------------------------------------
# Qpack Error Codes and Error Structure
# ---------------------------------------------------------------------------

pub QPACK_DECOMPRESSION_FAILED = 0x0200_u64
pub QPACK_ENCODER_STREAM_ERROR = 0x0201_u64
pub QPACK_DECODER_STREAM_ERROR = 0x0202_u64

pub struct QpackError
  getter code : UInt64
  getter message : String

  def initialize(@code : UInt64, @message : String)
  end

  def to_s : String
    "QpackError(0x#{@code.to_s}): #{@message}"
  end
end

# ---------------------------------------------------------------------------
# TableEntry and FieldLine
# ---------------------------------------------------------------------------

pub struct TableEntry
  getter name : String
  getter value : String

  def initialize(@name : String, @value : String)
  end

  def size : Int32
    @name.bytesize + @value.bytesize + 32
  end
end

pub struct FieldLine
  getter name : String
  getter value : String
  getter never_index : Bool

  def initialize(@name : String, @value : String, @never_index : Bool = false)
  end

  def size : Int32
    @name.bytesize + @value.bytesize + 32
  end

  def ==(other : FieldLine) : Bool
    @name == other.name && @value == other.value && @never_index == other.never_index
  end

  def to_s : String
    "(#{@name}: #{@value})"
  end
end

pub struct BlockedStream
  getter stream_id : UInt64
  getter req_insert_count : Int64
  getter base : Int64
  getter payload : Bytes
  getter payload_offset : Int32

  def initialize(@stream_id : UInt64, @req_insert_count : Int64, @base : Int64, @payload : Bytes, @payload_offset : Int32)
  end
end

